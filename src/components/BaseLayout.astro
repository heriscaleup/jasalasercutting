---
import '../styles/global.css';

interface MetaTags {
  title: string;
  description: string;
  keywords: string;
  canonical: string;
  url: string;
  type: string;
  openGraph: {
    title: string;
    description: string;
    url: string;
    image: string;
    type: string;
    siteName: string;
    locale: string;
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
  };
  twitter: {
    card: string;
    title: string;
    description: string;
    image: string;
  };
}

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  url?: string;
  type?: "article" | "website" | "blog" | "service" | "CollectionPage";
  noindex?: boolean;
  jsonLd?: any[];
  canonical?: string;
  metaTags?: MetaTags;
}

const {
  metaTags,
  title,
  description,
  keywords,
  image,
  url,
  type = "website",
  canonical,
  noindex = false,
  jsonLd
} = Astro.props;

if (!Astro.site) {
  throw new Error('SITE_URL environment variable is not set. Please update your astro.config.mjs');
}

const siteUrl = new URL(Astro.site);
const currentUrl = typeof Astro.url === 'string' ? Astro.url : Astro.url.href;
const pageUrl = url ? new URL(url, siteUrl).href : currentUrl;
const canonicalUrl = canonical ? new URL(canonical, siteUrl).href : pageUrl;
const defaultTitle = "Jasa Laser Cutting Profesional di Banten & Tangerang | Jasa Cutting Laser";
const defaultDescription = "Jasa laser cutting, CNC router, laser fiber, laser CO2, dan galvo engraving untuk kebutuhan akrilik, kayu, MDF, ACP, PVC, metal, dan signage.";
const defaultKeywords = "jasa laser cutting, laser cutting banten, laser cutting tangerang, cnc router, laser fiber, laser co2, galvo engraving";
const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const pageImage = image || "/images/logo.webp";

const generatedMetaTags = {
  title: pageTitle,
  description: pageDescription,
  keywords: keywords || defaultKeywords,
  canonical: canonicalUrl,
  url: pageUrl,
  type,
  openGraph: {
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: pageImage,
    type,
    siteName: "Jasa Cutting Laser",
    locale: "id_ID"
  },
  twitter: {
    card: "summary_large_image",
    title: pageTitle,
    description: pageDescription,
    image: pageImage
  }
};

const meta = metaTags || generatedMetaTags;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-Equiv="X-UA-Compatible" content="IE=edge" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="author" content="Jasa Cutting Laser Team" />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

    <meta property="og:type" content={meta.openGraph.type} />
    <meta property="og:title" content={meta.openGraph.title} />
    <meta property="og:description" content={meta.openGraph.description} />
    <meta property="og:url" content={meta.openGraph.url} />
    <meta property="og:image" content={new URL(meta.openGraph.image, siteUrl).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={meta.openGraph.siteName} />
    <meta property="og:locale" content={meta.openGraph.locale} />

    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={new URL(meta.twitter.image, siteUrl).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/images/logo.webp" as="image" type="image/webp" />
    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v12/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiA.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    <link rel="dns-prefetch" href="//api.whatsapp.com" />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />

    <!-- Google Analytics 4 -->
    <!-- Ganti G-LWLLCS1PG4 dengan GA4 Measurement ID kamu -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LWLLCS1PG4"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LWLLCS1PG4');
    </script>

    {jsonLd && jsonLd.length > 0 && jsonLd.map(json => (
      <script type="application/ld+json" set:html={JSON.stringify(json)} />
    ))}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Jasa Cutting Laser",
      url: siteUrl.href,
      logo: new URL("/images/logo.webp", siteUrl).href,
      description: "Solusi laser cutting profesional untuk kebutuhan material akrilik, kayu, MDF, ACP, PVC, metal, dan signage.",
      telephone: "+62 851 6569 3179",
      email: "info@jasalasercutting.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Jl. Raya Serang No. 123",
        addressLocality: "Serang",
        addressRegion: "Banten",
        postalCode: "42111",
        addressCountry: "ID"
      },
      openingHours: "Mo-Sa 08:00-17:00",
      areaServed: ["Serang", "Tangerang", "Cilegon", "Pandeglang", "Lebak"],
      serviceType: ["Laser Cutting", "CNC Router", "Laser Fiber", "Laser CO2", "Galvo Engraving"]
    })} />

    <meta name="theme-color" content="#00C853" />
  </head>
  <body class="antialiased bg-silver-light text-charcoal">
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    <slot name="header" />

    <main id="main-content" class="min-h-screen">
      <slot />
    </main>

    <slot name="footer" />

    <!-- WhatsApp Click Tracking -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('a[href*="api.whatsapp.com"], a[href*="wa.me"]').forEach(function (link) {
          link.addEventListener('click', function () {
            // Ambil label dari teks tombol atau atribut data-wa-label
            var label = link.dataset.waLabel || link.innerText.trim() || 'WhatsApp Button';
            var page = window.location.pathname;

            // Kirim event ke GA4
            if (typeof gtag === 'function') {
              gtag('event', 'whatsapp_click', {
                event_category: 'engagement',
                event_label: label,
                page_location: window.location.href,
                page_path: page
              });
            }
          });
        });
      });
    </script>
  </body>
</html>
