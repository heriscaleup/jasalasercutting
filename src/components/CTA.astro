---
// CTA.astro - Call-to-Action Premium Awwwards Redesign
import { SITE_CONFIG, WHATSAPP_MESSAGES } from '../utils/constants.js';

export interface Props {
  title?: string;
  description?: string;
  primaryText?: string;
  primaryLink?: string;
  secondaryText?: string;
  secondaryLink?: string;
}

const {
  title = "Siap Wujudkan Gagasan Desain Anda?",
  description = "Diskusikan rincian spesifikasi desain Anda sekarang secara gratis bersama tim teknis ahli kami, dapatkan rekomendasi efisiensi bahan dan penawaran harga terbaik.",
  primaryText = "Konsultasi Teknis Gratis",
  primaryLink = `https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${encodeURIComponent(WHATSAPP_MESSAGES.default)}`,
  secondaryText = "Form Estimasi Penawaran",
  secondaryLink = "#interactive-quote"
} = Astro.props;
---

<section class="py-24 bg-charcoal text-white relative overflow-hidden">

  <!-- Subtle geometric grid background -->
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1.5px 1.5px, #10B981 1.5px, transparent 0); background-size: 32px 32px;"></div>
  </div>

  <div class="container-custom relative z-10 text-center space-y-10 max-w-4xl">

    <div class="inline-flex items-center space-x-2 px-4 py-1.5 bg-laser-green/20 border border-laser-green/30 rounded-full text-laser-green font-bold text-xs tracking-wider uppercase">
      <span>Kolaborasi & Fabrikasi Berkelas</span>
    </div>

    <h2 class="heading-lg text-white leading-tight">
      {title}
    </h2>

    <p class="text-base md:text-lg text-silver-mid max-w-2xl mx-auto leading-relaxed font-sans">
      {description}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a
        href={primaryLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary w-full sm:w-auto text-base px-8 py-5 shadow-laser-glow flex items-center justify-center"
      >
        <svg class="w-5 h-5 text-white mr-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
        </svg>
        <span>{primaryText}</span>
      </a>

      <a
        href={secondaryLink}
        class="border-2 border-white/20 hover:border-white text-white hover:bg-white hover:text-charcoal font-semibold py-4.5 px-8 rounded-full transition-all duration-300 w-full sm:w-auto text-center text-base"
      >
        <span>{secondaryText}</span>
      </a>
    </div>

    <!-- Micro information stats -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-8 pt-8 text-sm text-silver-dark/80 font-sans">
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-laser-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Respon Penawaran Cepat</span>
      </div>
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-laser-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Analisis Berkas Desain Gratis</span>
      </div>
    </div>

  </div>
</section>
