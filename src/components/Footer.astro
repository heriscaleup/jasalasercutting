---
import { SITE_CONFIG, SERVICES, MATERIALS } from '../utils/constants.js';
---

<footer class="bg-charcoal text-white relative overflow-hidden border-t border-silver-mid/10">
  
  <!-- Subtle Grid overlay -->
  <div class="absolute inset-0 opacity-5 pointer-events-none">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 24px 24px;"></div>
  </div>

  <div class="relative z-10">
    <!-- Main Footer Container -->
    <div class="container-custom py-20 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-16">

        <!-- Column 1: Company Logo & Pitch -->
        <div class="lg:col-span-4 space-y-6">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-laser-green rounded-xl flex items-center justify-center font-heading font-bold text-white text-xl">
              J
            </div>
            <div>
              <h3 class="text-xl font-bold font-heading text-white">Jasa Cutting Laser</h3>
              <p class="text-[10px] text-silver-dark font-bold uppercase tracking-wider">Premium CNC Workshop</p>
            </div>
          </div>

          <p class="text-sm text-silver-dark leading-relaxed font-sans">
            One-stop solution untuk jasa laser cutting dan CNC Router presisi tinggi di Indonesia. Lebih dari 10 tahun melayani ribuan pengerjaan berskala manufaktur dengan garansi hasil pemotongan tanpa cacat.
          </p>

          <!-- Modern Aesthetic Social Icons -->
          <div class="flex items-center space-x-3 pt-2">
            {[
              { label: 'Facebook', svgPath: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
              { label: 'Instagram', svgPath: 'M12.017 0C5.396 0 .029 5.367.029 11.987c0 6.62 5.367 11.987 11.988 11.987 6.62 0 11.987-5.367 11.987-11.987C24.014 5.367 18.637.001 12.017.001zM8.449 16.988c-1.297 0-2.448-.611-3.197-1.559-.187-.237-.318-.507-.391-.799-.073-.292-.088-.598-.043-.898.089-.598.35-1.155.739-1.614.389-.459.897-.798 1.474-.985.577-.187 1.2-.214 1.794-.077.594.137 1.136.428 1.571.842.435.414.748.948.906 1.546.158.598.154 1.235-.011 1.831-.165.596-.479 1.136-.909 1.563-.43.427-.97.741-1.566.906-.298.083-.608.125-.918.125-.31 0-.62-.042-.918-.125-.596-.165-1.136-.479-1.563-.909z' }
            ].map(social => (
              <a href="#" aria-label={social.label} class="w-10 h-10 bg-white/5 hover:bg-laser-green text-white rounded-xl flex items-center justify-center transition-all hover:scale-105 border border-white/10">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d={social.svgPath}/>
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- Column 2: Quick Links (Layanan) -->
        <div class="lg:col-span-2 space-y-6">
          <h4 class="text-sm font-bold uppercase tracking-widest text-laser-green">
            Layanan Kami
          </h4>
          <ul class="space-y-3 font-sans">
            {SERVICES.map(service => (
              <li>
                <a href={`/${service.slug}/`} class="text-sm text-silver-dark hover:text-laser-green transition-colors flex items-center">
                  <span class="mr-2">›</span>
                  <span>{service.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 3: Materials -->
        <div class="lg:col-span-3 space-y-6">
          <h4 class="text-sm font-bold uppercase tracking-widest text-laser-green">
            Eksplorasi Bahan
          </h4>
          <ul class="space-y-3 font-sans">
            {MATERIALS.slice(0, 5).map(material => (
              <li>
                <a href={`/${material.slug}/`} class="text-sm text-silver-dark hover:text-laser-green transition-colors flex items-center">
                  <span class="mr-2">›</span>
                  <span>{material.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 4: Kontak Info -->
        <div class="lg:col-span-3 space-y-6">
          <h4 class="text-sm font-bold uppercase tracking-widest text-laser-green">
            Hubungi Workshop
          </h4>
          <div class="space-y-4 text-sm font-sans">
            <div class="flex items-start space-x-3 text-silver-dark">
              <svg class="w-5 h-5 text-laser-green flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>{SITE_CONFIG.address}</span>
            </div>

            <div class="flex items-start space-x-3 text-silver-dark">
              <svg class="w-5 h-5 text-laser-green flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <div>
                <a href={`tel:${SITE_CONFIG.phone}`} class="block font-bold text-white hover:text-laser-green transition-colors">{SITE_CONFIG.phone}</a>
                <span class="text-xs text-silver-dark/60">{SITE_CONFIG.businessHours}</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/5 bg-black/20 py-8 text-xs text-silver-dark">
      <div class="container-custom flex flex-col md:flex-row justify-between items-center gap-4 font-sans">
        <div class="flex flex-col md:flex-row items-center gap-2 md:gap-6 text-center md:text-left">
          <p>© 2025 Jasa Cutting Laser. All rights reserved.</p>
          <div class="flex items-center space-x-3">
            <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
            <span>•</span>
            <a href="/terms-of-service/" class="hover:text-white transition-colors">Terms of Service</a>
          </div>
        </div>
        <p class="text-center md:text-right">Workshop Berlisensi Industri • Seluruh Banten & Jabodetabek</p>
      </div>
    </div>
  </div>

  <!-- Floating Dynamic Contact Triggers (Only rendered on clients) -->
  <button id="back-to-top"
          aria-label="Back to top of page"
          class="fixed bottom-6 left-6 w-12 h-12 bg-laser-green hover:bg-laser-green-hover text-white rounded-full shadow-premium flex items-center justify-center transition-all duration-300 transform translate-y-16 opacity-0 z-40">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
    </svg>
  </button>

  <a href={`https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}`}
     target="_blank"
     rel="noopener noreferrer"
     aria-label="Chat via WhatsApp"
     class="fixed bottom-6 right-6 w-12 h-12 bg-[#25D366] hover:bg-[#20BA5A] text-white rounded-full shadow-premium flex items-center justify-center z-40 group">
    <svg class="w-6 h-6 group-hover:scale-105 transition-transform" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
    </svg>
    <div class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-10"></div>
  </a>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const b2t = document.getElementById('back-to-top');
    if (b2t) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          b2t.classList.remove('translate-y-16', 'opacity-0');
          b2t.classList.add('translate-y-0', 'opacity-100');
        } else {
          b2t.classList.remove('translate-y-0', 'opacity-100');
          b2t.classList.add('translate-y-16', 'opacity-0');
        }
      });

      b2t.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
