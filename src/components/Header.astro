---
// Header.astro - Modern Glassmorphic Awwwards Header Redesign
import { NAVIGATION, SITE_CONFIG } from '../utils/constants.js';

const currentPath = new URL(Astro.request.url).pathname;
const filteredNavigation = NAVIGATION.filter(item => item.name !== "Kontak").map(item => ({
  ...item,
  active: currentPath === `${item.href}` || (item.submenu && item.submenu.some(subitem => currentPath === `${subitem.href}`))
}));
---
<header class="fixed top-0 left-0 right-0 z-50 glass-header w-full" id="main-header">
  <div class="container-custom">
    <div class="flex items-center justify-between h-20 md:h-24 transition-all duration-300" id="header-inner">
      <!-- Logo Section -->
      <a href="/" class="flex items-center space-x-3 group z-50">
        <img
          src="/images/logo.webp"
          alt={SITE_CONFIG.title}
          class="w-10 h-10 object-contain rounded-xl shadow-laser-glow group-hover:scale-105 transition-transform duration-300"
          width="40"
          height="40"
        />
        <div class="flex flex-col">
          <span class="text-lg font-bold text-charcoal tracking-tight font-heading group-hover:text-laser-green transition-colors duration-300">
            Jasa Cutting Laser
          </span>
          <span class="text-[10px] text-graphite/70 font-semibold tracking-wider uppercase">Laser Cutting & CNC</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-10" aria-label="Main navigation">
        {filteredNavigation.map((item, index) => (
          <div class="relative group/nav">
            {item.submenu ? (
              <div class="relative">
                <button
                  class="flex items-center space-x-1 text-charcoal/80 hover:text-laser-green font-semibold py-2 transition-colors duration-300 text-sm tracking-wide"
                  aria-haspopup="true"
                  aria-expanded="false"
                  data-desktop-dropdown={index}
                >
                  <span>{item.name}</span>
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover/nav:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                <div class="absolute top-full left-1/2 -translate-x-1/2 mt-3 w-64 bg-white/95 backdrop-blur-md rounded-2xl shadow-premium border border-silver-mid/40 opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-300 transform translate-y-2 group-hover/nav:translate-y-0 z-50" data-desktop-menu={index}>
                  <div class="p-3 space-y-1">
                    {item.submenu.map((subitem) => (
                      <a
                        href={subitem.href}
                        class="flex items-center justify-between px-4 py-3 rounded-xl text-charcoal/80 hover:text-laser-green hover:bg-silver-light text-sm font-semibold transition-all duration-200"
                      >
                        <span>{subitem.name}</span>
                        <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 text-laser-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="text-charcoal/80 hover:text-laser-green font-semibold py-2 transition-colors duration-300 text-sm tracking-wide active-link-underline"
                class:list={[item.active && 'text-laser-green active']}
              >
                {item.name}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- Desktop Action Button -->
      <div class="hidden lg:flex items-center space-x-4">
        <a
          href="/contact/"
          class="btn-primary text-sm px-7 py-3 shadow-premium hover:shadow-premium-hover hover:scale-[1.03] transition-all"
        >
          Kontak Kita
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden flex flex-col items-center justify-center w-12 h-12 rounded-full border border-silver-dark/30 bg-white shadow-premium hover:bg-silver-light active:scale-95 transition-all z-50"
        id="mobile-menu-button"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <span class="w-5 h-[2px] bg-charcoal rounded-full transition-transform duration-300 mb-1" id="bar1"></span>
        <span class="w-5 h-[2px] bg-charcoal rounded-full transition-opacity duration-300 mb-1" id="bar2"></span>
        <span class="w-5 h-[2px] bg-charcoal rounded-full transition-transform duration-300" id="bar3"></span>
      </button>
    </div>
  </div>

  <!-- Fullscreen Interactive Overlay Mobile Menu -->
  <div
    class="lg:hidden fixed inset-0 bg-white/98 backdrop-blur-lg z-40 transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-y-auto flex flex-col pt-32 pb-10"
    id="mobile-menu"
  >
    <div class="container-custom flex-1 flex flex-col justify-between">
      <!-- Mobile Navigation Links -->
      <nav class="flex flex-col space-y-4" aria-label="Mobile navigation">
        {filteredNavigation.map((item, index) => (
          <div class="border-b border-silver-mid/40 pb-3">
            {item.submenu ? (
              <div>
                <button
                  class="flex items-center justify-between w-full text-left text-2xl font-heading font-bold text-charcoal py-2 hover:text-laser-green transition-colors"
                  data-submenu-index={index}
                  aria-expanded="false"
                >
                  <span>{item.name}</span>
                  <svg 
                    class="w-6 h-6 transition-transform duration-300"
                    id={`submenu-icon-${index}`}
                    fill="none" 
                    stroke="currentColor" 
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                <div 
                  class="hidden bg-silver-mid/20 rounded-2xl mt-2 overflow-hidden transition-all duration-300"
                  id={`submenu-${index}`}
                >
                  <div class="p-3 space-y-1">
                    {item.submenu.map((subitem) => (
                      <a
                        href={subitem.href}
                        class="block text-charcoal/80 hover:text-laser-green py-3 px-4 rounded-xl hover:bg-white text-base font-semibold transition-all duration-200"
                      >
                        {subitem.name}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="block text-2xl font-heading font-bold text-charcoal py-2 hover:text-laser-green transition-colors"
                class:list={[item.active && 'text-laser-green']}
              >
                {item.name}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- Mobile CTA Area -->
      <div class="mt-12 space-y-4">
        <a
          href="/contact/"
          class="btn-primary w-full text-center py-4 text-base shadow-laser-glow flex items-center justify-center"
        >
          <span>Hubungi Kami</span>
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <div class="grid grid-cols-2 gap-4">
          <a
            href={`https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${encodeURIComponent("Halo Jasa Cutting Laser, saya tertarik ingin berkonsultasi mengenai project.")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#25D366] hover:bg-[#20BA5A] text-white text-center py-3.5 px-4 rounded-full text-sm font-bold flex items-center justify-center space-x-2 transition-all hover:scale-[1.02] shadow-premium"
          >
            <span>WhatsApp</span>
          </a>
          <a
            href={`tel:${SITE_CONFIG.phone}`}
            class="bg-charcoal text-white text-center py-3.5 px-4 rounded-full text-sm font-bold flex items-center justify-center space-x-2 transition-all hover:scale-[1.02] shadow-premium"
          >
            <span>Hubungi Telepon</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script type="module">
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    const headerInner = document.getElementById('header-inner');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');
    const bar3 = document.getElementById('bar3');

    // Sticky Scroll Effect with glass-morphic accent
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header?.classList.add('glass-header-scrolled');
        headerInner?.classList.remove('h-20', 'md:h-24');
        headerInner?.classList.add('h-16', 'md:h-20');
      } else {
        header?.classList.remove('glass-header-scrolled');
        headerInner?.classList.remove('h-16', 'md:h-20');
        headerInner?.classList.add('h-20', 'md:h-24');
      }
    });

    // Mobile Menu Toggle Function with Animated Hamburger icon
    let isMenuOpen = false;

    function toggleMobileMenu() {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        mobileMenu?.classList.remove('translate-x-full');
        mobileMenuButton?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';

        // Animate hamburger to X
        bar1.style.transform = 'translateY(6px) rotate(45deg)';
        bar2.style.opacity = '0';
        bar3.style.transform = 'translateY(-6px) rotate(-45deg)';
      } else {
        mobileMenu?.classList.add('translate-x-full');
        mobileMenuButton?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';

        // Animate X back to hamburger
        bar1.style.transform = '';
        bar2.style.opacity = '';
        bar3.style.transform = '';

        // Reset submenus
        document.querySelectorAll('[id^="submenu-"]').forEach((submenu) => {
          submenu.classList.add('hidden');
        });
        document.querySelectorAll('[id^="submenu-icon-"]').forEach((icon) => {
          icon.style.transform = 'rotate(0deg)';
        });
        document.querySelectorAll('[data-submenu-index]').forEach((button) => {
          button.setAttribute('aria-expanded', 'false');
        });
      }
    }

    mobileMenuButton?.addEventListener('click', (e) => {
      e.preventDefault();
      toggleMobileMenu();
    });

    // Mobile submenu toggle
    document.querySelectorAll('[data-submenu-index]').forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const index = button.getAttribute('data-submenu-index');
        const submenu = document.getElementById(`submenu-${index}`);
        const icon = document.getElementById(`submenu-icon-${index}`);

        if (submenu && icon) {
          const isOpen = !submenu.classList.contains('hidden');
          if (isOpen) {
            submenu.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
            button.setAttribute('aria-expanded', 'false');
          } else {
            submenu.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
            button.setAttribute('aria-expanded', 'true');
          }
        }
      });
    });

    // Close mobile menu on clicking nav link
    document.querySelectorAll('#mobile-menu a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        setTimeout(() => {
          if (isMenuOpen) toggleMobileMenu();
        }, 150);
      });
    });

    // Handle escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen) {
        toggleMobileMenu();
      }
    });
  });
</script>
