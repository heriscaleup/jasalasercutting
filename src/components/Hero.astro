---
import { SITE_CONFIG, WHATSAPP_MESSAGES } from '../utils/constants.js';

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  primaryCTA?: string;
  primaryCTALink?: string;
  secondaryCTA?: string;
  secondaryCTALink?: string;
  backgroundImage?: string;
}

const {
  title = "Presisi Sempurna, Hasil Tanpa Batas",
  subtitle = "Jasa Laser Cutting & CNC Router Premium No. 1 di Indonesia",
  description = "Wujudkan desain paling kompleks sekalipun dengan akurasi pengerjaan hingga 0.05mm. Menggunakan mesin berteknologi mutakhir untuk material Acrylic, Metal, Kayu, MDF, ACP, hingga GRC. Cepat, bergaransi, dan berskala industri.",
  primaryCTA = "Konsultasi Gratis Sekarang",
  primaryCTALink = `https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${encodeURIComponent(WHATSAPP_MESSAGES.default)}`,
  secondaryCTA = "Eksplorasi Proyek Kami",
  secondaryCTALink = "/portfolio/",
  backgroundImage = "/images/logo.webp"
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#FAFAFA] pt-24 pb-16 geometric-bg">
  
  <!-- Subtle Abstract Ambient Radial Glow -->
  <div class="absolute top-1/4 left-10 w-96 h-96 bg-laser-green/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-10 w-96 h-96 bg-laser-green/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-custom relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Asymmetrical Column 1: Copywriting -->
      <div class="lg:col-span-7 text-left space-y-8 lg:pr-6">

        <!-- Premium Brand Label Badge -->
        <div class="inline-flex items-center space-x-2 px-4 py-2 bg-laser-green/10 border border-laser-green/20 rounded-full text-laser-green font-bold text-xs tracking-wider uppercase animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-laser-green animate-pulse"></span>
          <span>Awwwards-Level Precision Workshop</span>
        </div>

        <!-- Majestic Title with Dual-weight typography hierarchy -->
        <h1 class="heading-xl text-text-main tracking-tight leading-[1.1] animate-slide-up">
          {title}
        </h1>

        <!-- High contrast Subtitle -->
        <p class="text-xl md:text-2xl font-bold text-laser-green tracking-tight animate-slide-up" style="animation-delay: 0.15s;">
          {subtitle}
        </p>

        <!-- Elegant Narrative Description -->
        <p class="text-base md:text-lg text-text-secondary max-w-2xl leading-relaxed font-sans animate-slide-up" style="animation-delay: 0.3s;">
          {description}
        </p>

        <!-- CTA Interactions: High contrast, raised buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4 animate-slide-up" style="animation-delay: 0.45s;">
          <a
            href={primaryCTALink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-base px-8 py-5 group shadow-premium hover:shadow-premium-hover flex items-center justify-center"
          >
            <svg class="w-5 h-5 text-white mr-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
            </svg>
            <span>{primaryCTA}</span>
            <svg class="w-4 h-4 text-white ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href={secondaryCTALink}
            class="btn-secondary text-base px-8 py-5 hover:bg-charcoal hover:text-white transition-all shadow-premium"
          >
            <span>{secondaryCTA}</span>
          </a>
        </div>

        <!-- Trust Badges Block with Micro-grid -->
        <div class="pt-6 grid grid-cols-3 gap-6 border-t border-silver-mid/70 animate-fade-in" style="animation-delay: 0.6s;">
          <div class="space-y-1">
            <span class="block text-2xl font-bold font-heading text-text-main">10+ Tahun</span>
            <span class="block text-xs text-text-secondary font-semibold uppercase tracking-wider">Pengalaman Industri</span>
          </div>
          <div class="space-y-1">
            <span class="block text-2xl font-bold font-heading text-text-main">1,000+</span>
            <span class="block text-xs text-text-secondary font-semibold uppercase tracking-wider">Proyek Sukses</span>
          </div>
          <div class="space-y-1">
            <span class="block text-2xl font-bold font-heading text-text-main">100% OK</span>
            <span class="block text-xs text-text-secondary font-semibold uppercase tracking-wider">Garansi Kepuasan</span>
          </div>
        </div>

      </div>

      <!-- Asymmetrical Column 2: Visual Concept (Minimalist Machinery Blueprint/Geometric Display) -->
      <div class="lg:col-span-5 relative w-full flex items-center justify-center animate-fade-in" style="animation-delay: 0.4s;">
        <div class="relative w-full max-w-[450px] aspect-square">

          <!-- Outer Floating Precision Reticle Ring -->
          <div class="absolute inset-0 border-[1.5px] border-dashed border-silver-dark/40 rounded-full animate-spin-slow"></div>

          <!-- Nested Ring with Compass Markings -->
          <div class="absolute inset-8 border border-silver-dark/30 rounded-full flex items-center justify-center">
            <div class="absolute inset-4 border-[2px] border-laser-green/20 rounded-full"></div>
          </div>

          <!-- Focal Card (The machinery concept card with glassmorphic layers) -->
          <div class="absolute inset-16 bg-white border border-silver-mid/80 rounded-3xl shadow-premium overflow-hidden p-8 flex flex-col justify-between hover-lift">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="w-3 h-3 rounded-full bg-[#EF4444]"></span>
                <span class="text-xs font-bold text-graphite/60 font-heading tracking-widest uppercase">Laser Active</span>
              </div>
              <div class="text-[10px] font-mono text-laser-green font-bold bg-laser-green/10 px-2 py-1 rounded">X-109 / Y-245</div>
            </div>

            <!-- Architectural Blueprint Mockup -->
            <div class="relative flex-1 my-6 flex items-center justify-center">
              <div class="absolute w-full h-0.5 bg-silver-mid/50"></div>
              <div class="absolute h-full w-0.5 bg-silver-mid/50"></div>

              <!-- Laser Cutting Head Mockup -->
              <div class="relative z-10 w-24 h-24 border border-laser-green bg-white rounded-2xl flex items-center justify-center group cursor-pointer hover:shadow-laser-glow transition-all duration-300">
                <div class="w-10 h-10 border-2 border-dashed border-laser-green rounded-full flex items-center justify-center animate-spin-slow">
                  <div class="w-3 h-3 bg-laser-green rounded-full"></div>
                </div>
                <span class="absolute -bottom-2 bg-laser-green text-white text-[9px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">Tooling</span>
              </div>

              <!-- Animated target reticles -->
              <div class="absolute top-2 left-6 w-3 h-3 border border-charcoal/30 rounded-full"></div>
              <div class="absolute bottom-4 right-10 w-4 h-4 border border-charcoal/30 rounded-full"></div>
            </div>

            <div class="space-y-1 border-t border-silver-mid pt-4">
              <span class="block text-xs font-semibold text-graphite/60 uppercase">Spesifikasi Aktif:</span>
              <div class="flex justify-between items-center text-sm">
                <span class="font-bold text-charcoal">Area Pemotongan</span>
                <span class="font-bold text-laser-green">3000 x 1500 mm</span>
              </div>
            </div>
          </div>

          <!-- Abstract floating badge 1 -->
          <div class="absolute -top-4 -right-4 bg-white p-4 rounded-2xl shadow-premium border border-silver-mid/50 flex items-center space-x-3 hover-lift">
            <div class="w-10 h-10 bg-laser-green/15 rounded-xl flex items-center justify-center text-laser-green">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <span class="block text-[10px] text-graphite/60 font-bold uppercase tracking-wider">Kecepatan Potong</span>
              <span class="block text-sm font-bold text-charcoal">Hingga 50m/menit</span>
            </div>
          </div>

          <!-- Abstract floating badge 2 -->
          <div class="absolute -bottom-4 -left-4 bg-charcoal text-white p-4 rounded-2xl shadow-premium flex items-center space-x-3 hover-lift">
            <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center text-laser-green">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div>
              <span class="block text-[10px] text-white/50 font-bold uppercase tracking-wider">Presisi Toleransi</span>
              <span class="block text-sm font-bold text-laser-green">±0.05 mm</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Animated Bottom Scroll Indicator -->
  <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 z-20 flex flex-col items-center space-y-1">
    <span class="text-[10px] font-bold text-graphite/40 tracking-widest uppercase">Scroll Down</span>
    <div class="w-6 h-10 border-2 border-silver-dark/40 rounded-full flex justify-center p-1">
      <div class="w-1 h-2.5 bg-laser-green rounded-full animate-bounce"></div>
    </div>
  </div>

</section>

<style>
  /* Extra fluid animations */
  @keyframes spin-slow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 24s linear infinite;
  }
</style>
