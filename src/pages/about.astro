---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { SITE_CONFIG, SERVICES, MATERIALS } from '../utils/constants.js';
import { generateMetaTags, generateBreadcrumbSchema, generateLocalBusinessSchema } from '../utils/seo.ts';

const metaTags = generateMetaTags({ title: 'Tentang Kami | Jasa Cutting Laser', description: 'Mengenal Jasa Cutting Laser: workshop fabrikasi presisi untuk arsitektur, interior, signage, manufaktur, dan project custom di Tangerang Selatan, Banten, serta Jabodetabek.', keywords: 'tentang jasa cutting laser, workshop laser cutting tangerang, fabrikasi presisi banten, vendor cnc router', url: '/about/', type: 'website', image: '/images/team.webp' });
const breadcrumbSchema = generateBreadcrumbSchema([{ name: 'Beranda', url: '/' }, { name: 'Tentang Kami', url: '/about/' }]);
const localBusinessSchema = generateLocalBusinessSchema('Tangerang Selatan');
const principles = [['01', 'Baca kebutuhan sebelum mesin menyala', 'Kami mulai dari fungsi, ukuran, material, toleransi, dan cara pemasangan. Hasil bagus selalu dimulai dari brief yang terbaca.'], ['02', 'Pilih teknologi yang paling masuk akal', 'Fiber, CO2, CNC, dan galvo punya karakter berbeda. Kami memilih jalur produksi berdasarkan hasil yang dibutuhkan, bukan sekadar tren.'], ['03', 'Kontrol kualitas sampai siap dipakai', 'Kami memeriksa detail potong, ukuran, edge, dan kebutuhan finishing agar komponen tidak berhenti sebagai barang bagus di foto.']];
const gallery = [['/images/laserfiber.webp', 'Fiber laser'], ['/images/cncrouter.webp', 'CNC router'], ['/images/galvo.webp', 'Galvo engraving'], ['/images/Acrylic.webp', 'Acrylic'], ['/images/metal.webp', 'Metal'], ['/images/prototype.webp', 'Prototype']];
---

<BaseLayout metaTags={metaTags} jsonLd={[breadcrumbSchema, localBusinessSchema]}>
  <Header slot="header" />
  <div class="about-page overflow-hidden">
    <section class="relative isolate border-b border-[var(--line)] pt-28" data-no-reveal><div class="absolute inset-0 -z-20"><img src="/images/team.webp" alt="Workshop tim Jasa Cutting Laser" class="h-full w-full object-cover opacity-35" width="1800" height="1000" fetchpriority="high" /><div class="absolute inset-0 bg-[linear-gradient(90deg,var(--ink)_0%,rgba(8,11,10,.88)_48%,rgba(8,11,10,.42)_100%)]"></div></div><div class="container-custom grid min-h-[min(700px,calc(100svh-5rem))] items-end gap-12 pb-14 lg:grid-cols-[1fr_.48fr] lg:pb-20"><div><p class="eyebrow">About / JCL workshop</p><h1 class="heading-xl mt-6 max-w-5xl">Kami membuat<br /><span class="text-[var(--acid)]">ide jadi komponen.</span></h1><p class="mt-8 max-w-2xl text-lg leading-8 text-[var(--muted)]">Jasa Cutting Laser adalah workshop fabrikasi presisi untuk orang-orang yang membutuhkan hasil yang bisa dipasang, diproduksi ulang, dan dipertanggungjawabkan.</p></div><div class="border border-white/15 bg-[rgba(8,11,10,.62)] p-6 backdrop-blur-md"><span class="font-mono text-[.62rem] uppercase tracking-[.14em] text-[var(--muted)]">Base of operation</span><strong class="mt-3 block font-heading text-2xl text-[var(--paper)]">Tangerang Selatan</strong><p class="mt-3 text-sm leading-6 text-[var(--muted)]">Melayani Banten, Jabodetabek, dan kebutuhan produksi lintas kota.</p><div class="mt-5 border-t border-white/10 pt-4 font-mono text-[.62rem] uppercase tracking-[.12em] text-[var(--acid)]">Open for collaboration ↗</div></div></div></section>

    <section class="border-b border-[var(--line)]" data-no-reveal><div class="container-custom grid gap-12 py-16 md:py-24 lg:grid-cols-[.8fr_1.2fr] lg:items-start"><div><p class="eyebrow">01 / The story</p><h2 class="heading-lg mt-5">Bukan hanya<br /><span class="text-[var(--acid)]">jasa potong.</span></h2></div><div class="max-w-3xl text-lg leading-9 text-[var(--muted)]"><p>Di lapangan, laser cutting hampir selalu menjadi satu bagian dari pekerjaan yang lebih besar: panel harus bertemu struktur, signage harus terbaca, komponen harus konsisten, dan material harus sesuai dengan lingkungan pemakaian.</p><p class="mt-6">Karena itu kami membangun proses yang menggabungkan pembacaan file, rekomendasi material, pengaturan produksi, kontrol kualitas, dan komunikasi yang jelas. Tujuannya sederhana: mengurangi kejutan ketika hasil berpindah dari layar ke dunia nyata.</p><p class="mt-6">Kami melayani kebutuhan dari prototype dan project personal sampai batch komersial. Skala boleh berbeda, standar berpikirnya tetap sama.</p></div></div></section>

    <section class="border-b border-[var(--line)] bg-[var(--ink-soft)]" data-no-reveal><div class="container-custom grid grid-cols-2 gap-px overflow-hidden border border-[var(--line)] bg-[var(--line)] md:grid-cols-4">{[['10+', 'tahun pengalaman'], ['1,000+', 'project selesai'], ['±0.1', 'mm toleransi kerja'], ['4', 'jalur teknologi']].map((stat) => <div class="bg-[var(--panel)] p-6 md:p-8"><strong class="block font-heading text-5xl text-[var(--acid)] md:text-6xl">{stat[0]}</strong><span class="mt-3 block font-mono text-[.62rem] uppercase tracking-[.14em] text-[var(--muted)]">{stat[1]}</span></div>)}</div></section>

    <section class="section-padding border-b border-[var(--line)]" data-no-reveal><div class="container-custom"><div class="mb-12 max-w-2xl"><p class="eyebrow">02 / Working principles</p><h2 class="heading-lg mt-5">Cara kami menjaga<br /><span class="text-[var(--acid)]">hasil tetap masuk akal.</span></h2></div><div class="grid gap-px overflow-hidden border border-[var(--line)] bg-[var(--line)] lg:grid-cols-3">{principles.map((item) => <div class="bg-[var(--panel)] p-7 transition-colors hover:bg-[var(--panel-2)] md:p-9"><span class="font-mono text-xs text-[var(--acid)]">{item[0]}</span><h3 class="mt-16 font-heading text-2xl font-bold leading-tight">{item[1]}</h3><p class="mt-5 text-sm leading-7">{item[2]}</p></div>)}</div></div></section>

    <section class="section-padding border-b border-[var(--line)] bg-[var(--paper)] text-[var(--ink)]" data-no-reveal><div class="container-custom"><div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-end"><div><p class="eyebrow !text-[var(--acid-deep)]">03 / What we operate</p><h2 class="heading-lg mt-5 !text-[var(--ink)]">Kapabilitas yang<br /><span class="!text-[var(--acid-deep)]">saling melengkapi.</span></h2></div><p class="max-w-xl text-base leading-8 !text-[#53615a]">Satu project dapat membutuhkan lebih dari satu teknologi. Kami membantu menentukan kombinasi yang paling efisien untuk hasil akhir.</p></div><div class="mt-12 grid gap-4 md:grid-cols-2">{SERVICES.map((service, index) => <a href={`/${service.slug}/`} class="group border border-black/10 bg-white p-6 transition-all hover:-translate-y-1 hover:border-[var(--acid-deep)]"><div class="flex items-center justify-between"><span class="font-mono text-xs !text-[var(--acid-deep)]">0{index + 1}</span><span class="text-xl !text-[var(--acid-deep)] transition-transform group-hover:translate-x-1">↗</span></div><h3 class="mt-12 font-heading text-3xl font-bold !text-[var(--ink)]">{service.name}</h3><p class="mt-4 text-sm leading-7 !text-[#53615a]">{service.description}</p></a>)}</div></div></section>

    <section class="section-padding border-b border-[var(--line)]" data-no-reveal><div class="container-custom grid gap-12 lg:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow">04 / Material thinking</p><h2 class="heading-lg mt-5">Material bukan<br /><span class="text-[var(--acid)]">sekadar pilihan.</span></h2><p class="mt-6 max-w-sm text-sm leading-7 text-[var(--muted)]">Ketebalan, tekstur, edge, finishing, dan lingkungan pemakaian ikut menentukan apakah desain akan bertahan setelah diproduksi.</p></div><div class="grid grid-cols-2 gap-3 md:grid-cols-3">{MATERIALS.slice(0, 6).map((material) => <a href={`/${material.slug}/`} class="border border-[var(--line)] bg-[var(--panel)] p-5 transition-colors hover:border-[var(--acid)]"><span class="font-mono text-[.58rem] uppercase tracking-[.12em] text-[var(--acid)]">Material library</span><h3 class="mt-8 font-heading text-xl font-bold">{material.name}</h3><span class="mt-4 block font-mono text-xs text-[var(--muted)]">Explore ↗</span></a>)}</div></div></section>

    <section class="section-padding border-b border-[var(--line)] bg-[var(--ink-soft)]" data-no-reveal><div class="container-custom"><div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="eyebrow">05 / Workshop view</p><h2 class="heading-lg mt-5">Tempat kerja.<br /><span class="text-[var(--acid)]">Bukan stock photo.</span></h2></div><p class="max-w-sm text-sm leading-7 text-[var(--muted)]">Beberapa area, alat, dan hasil yang membentuk cara kami bekerja sehari-hari.</p></div><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{gallery.map((item, index) => <div class:list={["group relative overflow-hidden border border-[var(--line)] bg-[var(--panel)]", index === 0 && 'sm:col-span-2 lg:col-span-2']}><img src={item[0]} alt={item[1]} class="h-full min-h-48 w-full object-cover opacity-70 grayscale transition duration-700 group-hover:scale-105 group-hover:opacity-100 group-hover:grayscale-0" width="900" height="650" loading="lazy" /><div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[rgba(8,11,10,.9)] to-transparent p-5 pt-14"><span class="font-mono text-[.6rem] uppercase tracking-[.14em] text-[var(--acid)]">0{index + 1}</span><h3 class="mt-2 font-heading text-xl font-bold">{item[1]}</h3></div></div>)}</div></div></section>

    <section class="section-padding" data-no-reveal><div class="container-custom grid gap-12 lg:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow">06 / A clear handoff</p><h2 class="heading-lg mt-5">Dari brief<br /><span class="text-[var(--acid)]">sampai terpasang.</span></h2></div><div class="grid border-y border-[var(--line)]">{[['01', 'Kirim file dan konteks', 'Boleh CAD, PDF, AI, sketsa, atau foto referensi. Sertakan ukuran dan jumlah jika sudah ada.'], ['02', 'Kami baca dan jawab', 'Tim memberi catatan teknis, pilihan material, asumsi, serta pertanyaan yang memang perlu dijawab.'], ['03', 'Produksi dengan kontrol', 'File final masuk ke jalur produksi yang sesuai dan diperiksa sebelum diserahkan.'], ['04', 'Hasil siap digunakan', 'Produk dikemas, dikirim, atau disiapkan untuk pickup sesuai kebutuhan project.']].map((item) => <div class="grid gap-4 border-b border-[var(--line)] py-6 last:border-0 md:grid-cols-[4rem_1fr_1fr] md:items-center"><span class="font-mono text-xs text-[var(--acid)]">{item[0]}</span><h3 class="font-heading text-2xl font-bold">{item[1]}</h3><p class="text-sm leading-7">{item[2]}</p></div>)}</div></div></section>

    <CTA title="Bawa project Anda ke meja workshop." description="Ceritakan kebutuhan, kirim file, dan biarkan tim kami membantu menyusun jalur produksi yang paling masuk akal." primaryText="Konsultasi Gratis" primaryLink={`https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${encodeURIComponent('Halo Jasa Cutting Laser, saya ingin konsultasi project.')}`} secondaryText="Lihat Portfolio" secondaryLink="/portfolio/" />
  </div>
  <Footer slot="footer" />
</BaseLayout>
