---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SERVICES, MATERIALS, PORTFOLIO_PROJECTS, TESTIMONIALS, FAQ, SITE_CONFIG } from '../utils/constants.js';
import { generateMetaTags, generateFAQSchema, generateReviewSchema } from '../utils/seo.ts';

const metaTags = generateMetaTags({
  title: 'Jasa Laser Cutting Presisi untuk Arsitektur, Interior & Manufaktur',
  description: 'Laser cutting, CNC router, fiber laser, CO2, dan galvo engraving untuk project nyata. Kirim file, dapatkan analisis teknis dan estimasi yang jelas.',
  keywords: 'jasa laser cutting, laser cutting tangerang, laser cutting banten, jasa cnc router, laser fiber, laser co2, galvo engraving',
  url: '/', type: 'website', image: '/images/home/hero-workshop.webp', modifiedTime: '2026-07-16T00:00:00Z', author: SITE_CONFIG.author
});

const whatsapp = `https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${encodeURIComponent('Halo Jasa Cutting Laser, saya ingin konsultasi project.')}`;
const faqSchema = generateFAQSchema(FAQ);
const reviewSchema = generateReviewSchema(TESTIMONIALS);
const featuredServices = SERVICES.slice(0, 4);
const featuredMaterials = MATERIALS.slice(0, 6);
const featuredProjects = PORTFOLIO_PROJECTS.slice(0, 6);
---

<BaseLayout metaTags={metaTags} jsonLd={[faqSchema, reviewSchema]}>
  <Header slot="header" />

  <div class="home-page overflow-hidden">
    <section class="relative flex min-h-[min(900px,100svh)] items-end border-b border-[var(--line)] pt-28" data-reveal>
      <div class="absolute inset-0 -z-10"><picture class="block h-full w-full"><source media="(max-width: 640px)" srcset="/images/home/hero-workshop-mobile.webp" /><img src="/images/home/hero-workshop.webp" alt="Workshop laser cutting dan fabrikasi" class="h-full w-full object-cover opacity-40" width="1376" height="768" fetchpriority="high" decoding="async" /></picture><div class="absolute inset-0 bg-[linear-gradient(90deg,var(--ink)_0%,rgba(8,11,10,.86)_38%,rgba(8,11,10,.24)_100%)]"></div><div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_35%,rgba(184,255,61,.14),transparent 28rem)]"></div></div>
      <div class="container-custom grid w-full gap-14 pb-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(20rem,.7fr)] lg:items-end lg:pb-14">
        <div>
          <div class="mb-7 flex items-center gap-3 font-mono text-[.66rem] uppercase tracking-[.18em] text-[var(--muted)]"><span class="h-2 w-2 animate-pulse rounded-full bg-[var(--acid)]"></span>Precision fabrication · Tangerang Selatan</div>
          <h1 class="heading-xl max-w-5xl text-[var(--paper)]">Bikin bentuk.<br /><span class="text-[var(--acid)]">Bukan sekadar potong.</span></h1>
          <p class="mt-8 max-w-2xl text-base leading-8 text-[var(--muted)] md:text-xl">Kami menerjemahkan file CAD, sketsa, dan ide mentah menjadi komponen presisi untuk arsitektur, interior, signage, display, hingga manufaktur.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary" data-wa-label="Hero consultation">Kirim detail project <span aria-hidden="true">↗</span></a><a href="/portfolio/" class="btn-secondary">Lihat hasil kerja <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="relative lg:pb-2"><div class="scanline line-panel p-5 backdrop-blur-md"><div class="flex items-center justify-between border-b border-[var(--line)] pb-4 font-mono text-[.62rem] uppercase tracking-[.12em] text-[var(--muted)]"><span>Live capability index</span><span class="text-[var(--acid)]">JCL / 2026</span></div><div class="grid grid-cols-2 gap-4 pt-5"><div><strong class="block font-heading text-4xl text-[var(--paper)]">±0.1</strong><span class="font-mono text-[.62rem] uppercase tracking-[.12em] text-[var(--muted)]">mm tolerance</span></div><div><strong class="block font-heading text-4xl text-[var(--paper)]">4×</strong><span class="font-mono text-[.62rem] uppercase tracking-[.12em] text-[var(--muted)]">production tech</span></div><div class="col-span-2 border-t border-[var(--line)] pt-4"><span class="font-mono text-[.62rem] uppercase tracking-[.12em] text-[var(--muted)]">Scope</span><p class="mt-2 text-sm leading-6 text-[var(--paper)]">Fiber · CO2 · CNC · Galvo / small batch sampai industrial run</p></div></div></div><div class="float-slow absolute -right-4 -top-7 hidden border border-[var(--acid)] bg-[var(--acid)] px-3 py-2 font-mono text-[.6rem] font-bold uppercase tracking-[.13em] text-[var(--ink)] sm:block">Design → Material → Reality</div></div>
      </div>
      <a href="#services" class="absolute bottom-7 left-1/2 hidden -translate-x-1/2 items-center gap-3 font-mono text-[.62rem] uppercase tracking-[.18em] text-[var(--muted)] md:flex"><span class="h-10 w-px bg-[var(--acid)]"></span>Scroll to explore</a>
    </section>

    <section class="overflow-hidden border-b border-[var(--line)] bg-[var(--acid)] py-3 text-[var(--ink)]"><div class="flex w-max animate-[marquee-track_30s_linear_infinite] font-mono text-xs font-bold uppercase tracking-[.16em]"><span class="px-5">Laser cutting ✳ CNC router ✳ Fiber metal ✳ CO2 non-metal ✳ Galvo engraving ✳ </span><span class="px-5">Laser cutting ✳ CNC router ✳ Fiber metal ✳ CO2 non-metal ✳ Galvo engraving ✳ </span><span class="px-5">Laser cutting ✳ CNC router ✳ Fiber metal ✳ CO2 non-metal ✳ Galvo engraving ✳ </span></div></section>

    <section id="services" class="section-padding border-b border-[var(--line)]" data-reveal><div class="container-custom"><div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-end"><div><p class="eyebrow">01 / Capabilities</p><h2 class="heading-lg mt-5">Satu workshop.<br /><span class="text-[var(--acid)]">Empat cara presisi.</span></h2></div><p class="max-w-xl text-base leading-8 text-[var(--muted)]">Pilih teknologi berdasarkan material, detail, ketebalan, dan target produksi. Tim teknis kami membantu menghindari keputusan mahal sebelum mesin menyala.</p></div><div class="mt-14 grid gap-px overflow-hidden border border-[var(--line)] bg-[var(--line)] md:grid-cols-2">{featuredServices.map((service, index) => <a href={`/${service.slug}/`} class="group relative min-h-[18rem] overflow-hidden bg-[var(--panel)] p-6 transition-colors hover:bg-[var(--panel-2)] md:p-8"><div class="absolute right-6 top-6 font-mono text-xs text-[var(--muted)]">0{index + 1}</div><div class="mb-12 flex items-center justify-between"><span class="grid h-11 w-11 place-items-center border border-[var(--acid)]/40 font-mono text-sm text-[var(--acid)]">{String(index + 1).padStart(2, '0')}</span><span class="translate-x-2 text-2xl text-[var(--acid)] opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">↗</span></div><h3 class="font-heading text-3xl font-bold text-[var(--paper)]">{service.name}</h3><p class="mt-4 max-w-md text-sm leading-7">{service.description}</p><div class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-[var(--acid)] transition-transform duration-500 group-hover:scale-x-100"></div></a>)}</div></div></section>

    <section id="materials" class="section-padding border-b border-[var(--line)] bg-[var(--ink-soft)]" data-reveal><div class="container-custom"><div class="flex flex-col justify-between gap-7 md:flex-row md:items-end"><div><p class="eyebrow">02 / Material library</p><h2 class="heading-lg mt-5">Material punya<br /><span class="text-[var(--acid)]">karakternya sendiri.</span></h2></div><a href="/portfolio/" class="font-mono text-xs font-bold uppercase tracking-[.14em] text-[var(--acid)]">Buka arsip project ↗</a></div><div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{featuredMaterials.map((material, index) => <a href={`/${material.slug}/`} class="group hover-lift relative aspect-[1.15] overflow-hidden border border-[var(--line)] bg-[var(--panel)]"><img src={material.image || '/images/placeholder.webp'} alt={material.name} loading="lazy" class="h-full w-full object-cover opacity-50 grayscale transition-all duration-700 group-hover:scale-105 group-hover:opacity-75 group-hover:grayscale-0" width="800" height="700" /><div class="absolute inset-0 bg-gradient-to-t from-[var(--ink)] via-transparent to-transparent"></div><div class="absolute inset-x-5 bottom-5 flex items-end justify-between gap-4"><div><span class="font-mono text-[.6rem] uppercase tracking-[.14em] text-[var(--acid)]">0{index + 1} / material</span><h3 class="mt-2 font-heading text-2xl font-bold">{material.name}</h3></div><span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/20 text-xl transition-colors group-hover:border-[var(--acid)] group-hover:text-[var(--acid)]">↗</span></div></a>)}</div></div></section>

    <section class="section-padding border-b border-[var(--line)]" data-reveal><div class="container-custom"><div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><p class="eyebrow">03 / Production logic</p><h2 class="heading-lg mt-5">Proses yang<br /><span class="text-[var(--acid)]">terbaca.</span></h2><p class="mt-6 max-w-sm text-sm leading-7">Tidak ada black box. Setiap project melewati alur yang sama: jelas di awal, terkendali di tengah, siap dipasang di akhir.</p></div><div class="grid border-y border-[var(--line)]">{[['01','Baca file','Kami cek geometri, skala, toleransi, dan risiko material.'],['02','Pilih jalur produksi','Teknologi dipilih berdasarkan hasil yang dibutuhkan, bukan sekadar mesin yang tersedia.'],['03','Potong & kontrol','Operator menjalankan proses dengan QC visual dan dimensional sebelum packing.'],['04','Serah terima','Produk dikirim atau diambil dengan detail finishing yang sudah disepakati.']].map((item) => <div class="group grid gap-4 border-b border-[var(--line)] py-6 last:border-0 md:grid-cols-[5rem_1fr_1fr] md:items-center"><span class="font-mono text-xs text-[var(--acid)]">{item[0]}</span><h3 class="font-heading text-2xl font-bold">{item[1]}</h3><p class="text-sm leading-6">{item[2]}</p></div>)}</div></div></div></section>

    <section class="section-padding border-b border-[var(--line)] bg-[var(--paper)] text-[var(--ink)]" data-reveal><div class="container-custom"><div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-end"><div><p class="eyebrow !text-[var(--acid-deep)]">04 / Project archive</p><h2 class="heading-lg mt-5 !text-[var(--ink)]">Bukti kerja,<br /><span class="!text-[var(--acid-deep)]">bukan janji.</span></h2></div><p class="max-w-xl text-base leading-8 !text-[#53615a]">Dari panel dekoratif hingga komponen metal, setiap hasil lahir dari kombinasi file yang benar, material yang tepat, dan kontrol proses.</p></div><div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{featuredProjects.map((project, index) => <a href="/portfolio/" class="group overflow-hidden border border-black/10 bg-white"><div class="relative aspect-[4/3] overflow-hidden"><img src={project.image || '/images/placeholder.webp'} alt={project.title} loading="lazy" class="h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0" width="800" height="600" /><span class="absolute left-4 top-4 border border-white/30 bg-black/45 px-2 py-1 font-mono text-[.58rem] uppercase tracking-[.12em] text-white">0{index + 1}</span></div><div class="flex items-start justify-between gap-3 p-5"><div><h3 class="font-heading text-xl font-bold !text-[var(--ink)]">{project.title}</h3><p class="mt-1 text-xs !text-[#53615a]">{project.client || 'Custom fabrication project'}</p></div><span class="text-xl !text-[var(--acid-deep)]">↗</span></div></a>)}</div></div></section>

    <section id="interactive-quote" class="section-padding border-b border-[var(--line)]" data-reveal><div class="container-custom grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-start"><div><p class="eyebrow">05 / Start a project</p><h2 class="heading-lg mt-5">Berangkat dari<br /><span class="text-[var(--acid)]">file Anda.</span></h2><p class="mt-6 max-w-md text-base leading-8">Isi data minimum di bawah. Form ini akan menyusun pesan WhatsApp agar tim kami bisa membaca kebutuhan Anda lebih cepat.</p><div class="mt-9 flex flex-wrap gap-3 font-mono text-[.62rem] uppercase tracking-[.12em] text-[var(--muted)]"><span class="border border-[var(--line)] px-3 py-2">CAD / AI / PDF</span><span class="border border-[var(--line)] px-3 py-2">Konsultasi gratis</span><span class="border border-[var(--line)] px-3 py-2">Respon cepat</span></div></div><form id="quote-builder-form" class="line-panel grid gap-5 p-5 md:p-8"><div class="grid gap-5 md:grid-cols-2"><label class="grid gap-2 text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)]">Nama<input name="name" required class="border border-[var(--line)] bg-[var(--ink)] px-4 py-3 text-sm font-normal normal-case tracking-normal text-[var(--paper)] outline-none transition-colors focus:border-[var(--acid)]" placeholder="Nama Anda" /></label><label class="grid gap-2 text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)]">Material<select name="material" class="border border-[var(--line)] bg-[var(--ink)] px-4 py-3 text-sm font-normal normal-case tracking-normal text-[var(--paper)] outline-none focus:border-[var(--acid)]">{MATERIALS.slice(0, 7).map((material) => <option>{material.name}</option>)}</select></label></div><div class="grid gap-5 md:grid-cols-2"><label class="grid gap-2 text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)]">Dimensi / jumlah<input name="scope" required class="border border-[var(--line)] bg-[var(--ink)] px-4 py-3 text-sm font-normal normal-case tracking-normal text-[var(--paper)] outline-none focus:border-[var(--acid)]" placeholder="Contoh: 10 pcs, 60 × 120 cm" /></label><label class="grid gap-2 text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)]">Layanan<select name="service" class="border border-[var(--line)] bg-[var(--ink)] px-4 py-3 text-sm font-normal normal-case tracking-normal text-[var(--paper)] outline-none focus:border-[var(--acid)]">{featuredServices.map((service) => <option>{service.name}</option>)}</select></label></div><label class="grid gap-2 text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)]">Catatan project<textarea name="notes" rows="4" class="resize-none border border-[var(--line)] bg-[var(--ink)] px-4 py-3 text-sm font-normal normal-case tracking-normal text-[var(--paper)] outline-none focus:border-[var(--acid)]" placeholder="Material, finishing, deadline, atau link referensi…"></textarea></label><button class="btn-primary w-full" type="submit">Susun pesan konsultasi <span aria-hidden="true">↗</span></button><p id="quote-status" class="hidden text-center font-mono text-xs text-[var(--acid)]">Pesan siap dikirim. WhatsApp akan terbuka di tab baru.</p></form></div></section>

    <section class="section-padding border-b border-[var(--line)] bg-[var(--ink-soft)]" data-reveal><div class="container-custom"><div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow">06 / Client signal</p><h2 class="heading-lg mt-5">Yang penting<br /><span class="text-[var(--acid)]">hasilnya nyambung.</span></h2></div><div class="grid gap-4 md:grid-cols-2">{TESTIMONIALS.slice(0, 4).map((testi) => <figure class="line-panel p-6"><div class="font-mono text-sm tracking-[.2em] text-[var(--acid)]">★★★★★</div><blockquote class="mt-5 text-base leading-7 text-[var(--paper)]">“{testi.content}”</blockquote><figcaption class="mt-6 border-t border-[var(--line)] pt-4 font-mono text-[.65rem] uppercase tracking-[.12em] text-[var(--muted)]">{testi.name} · {testi.company}</figcaption></figure>)}</div></div></div></section>

    <section class="section-padding" data-reveal><div class="container-custom max-w-4xl"><div class="mb-12"><p class="eyebrow">07 / FAQ</p><h2 class="heading-lg mt-5">Pertanyaan sebelum<br /><span class="text-[var(--acid)]">mesin menyala.</span></h2></div><div class="border-t border-[var(--line)]">{FAQ.slice(0, 6).map((faq) => <details class="group border-b border-[var(--line)] py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-heading text-xl font-bold text-[var(--paper)]">{faq.question}<span class="text-2xl font-normal text-[var(--acid)] transition-transform group-open:rotate-45">＋</span></summary><p class="max-w-2xl pt-4 text-sm leading-7">{faq.answer}</p></details>)}</div></div></section>

    <section class="relative overflow-hidden border-t border-[var(--line)] bg-[var(--acid)] py-16 text-[var(--ink)] md:py-24"><div class="container-custom relative"><div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end"><h2 class="heading-lg max-w-3xl !text-[var(--ink)]">Ide besar layak dibuat dengan presisi.</h2><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-secondary border-[var(--ink)] !text-[var(--ink)] hover:bg-[var(--ink)] hover:!text-[var(--acid)]" data-wa-label="Bottom CTA">Konsultasi sekarang ↗</a></div></div></section>
  </div>
  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => { const form = document.querySelector('#quote-builder-form'); const status = document.querySelector('#quote-status'); form?.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); const message = ['Halo Jasa Cutting Laser, saya ingin konsultasi project.', `Nama: ${data.get('name')}`, `Material: ${data.get('material')}`, `Dimensi/jumlah: ${data.get('scope')}`, `Layanan: ${data.get('service')}`, `Catatan: ${data.get('notes') || '-'}`].join('\n'); if (status) status.classList.remove('hidden'); if (typeof window.gtag === 'function') window.gtag('event', 'whatsapp_click', { event_category: 'engagement', event_label: 'Quote Builder Form', page_path: window.location.pathname }); window.open(`https://api.whatsapp.com/send?phone=6285165693179&text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer'); }); });
</script>

<style is:global>
  @keyframes marquee-track { from { transform: translateX(0); } to { transform: translateX(-33.333%); } }
</style>
