<!-- Core Client-Side Interactivity Scripts -->
<script is:inline define:vars={{ MATERIALS }}>
  document.addEventListener('DOMContentLoaded', () => {
    // FAQ Accordion logic
    const faqContainer = document.querySelector('[data-faq-container]');
    if (faqContainer) {
      faqContainer.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;
        const button = e.target.closest('[data-faq-button]');
        if (!button) return;

        const answer = button.nextElementSibling;
        const icon = button.querySelector('[data-faq-icon]');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';

        button.setAttribute('aria-expanded', String(!isExpanded));

        if (answer && answer instanceof HTMLElement) {
          answer.style.maxHeight = isExpanded ? "0" : answer.scrollHeight + "px";
        }
        if (icon) {
          icon.classList.toggle('rotate-180');
        }
      });
    }

    // Material tab logic
    const tabButtons = document.querySelectorAll('.material-tab-btn');
    const panelTitle = document.getElementById('panel-title');
    const panelDesc = document.getElementById('panel-desc');
    const panelThickness = document.getElementById('panel-thickness');
    const panelAdvantage = document.getElementById('panel-advantage');
    const panelApps = document.getElementById('panel-apps');
    const panelLink = document.getElementById('panel-link');
    const panelImage = document.getElementById('panel-image');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const materialId = btn.getAttribute('data-material-id');
        const activeMaterial = MATERIALS.find((m) => m.id === materialId);

        if (!activeMaterial) return;

        // Reset classes
        tabButtons.forEach((b) => {
          b.classList.remove('bg-charcoal', 'text-white', 'border-charcoal', 'shadow-premium');
          b.classList.add('bg-white', 'text-charcoal', 'border-silver-dark/30');
        });

        // Set active classes
        btn.classList.remove('bg-white', 'text-charcoal', 'border-silver-dark/30');
        btn.classList.add('bg-charcoal', 'text-white', 'border-charcoal', 'shadow-premium');

        // Update Panel Content
        if (panelTitle) panelTitle.innerText = activeMaterial.name;
        if (panelDesc) panelDesc.innerText = activeMaterial.description;
        if (panelThickness) panelThickness.innerText = activeMaterial.thickness;
        if (panelAdvantage) panelAdvantage.innerText = activeMaterial.advantages?.[0] || 'Kualitas Premium';

        if (panelApps) {
          panelApps.innerHTML = activeMaterial.applications
            .map((app) => `<span class="px-3.5 py-1.5 bg-silver-mid text-charcoal font-semibold text-xs rounded-full">${app}</span>`)
            .join('');
        }

        if (panelLink) panelLink.setAttribute('href', `/${activeMaterial.slug}`);
        if (panelImage) {
          panelImage.setAttribute('src', activeMaterial.image);
          panelImage.setAttribute('alt', activeMaterial.name);
        }
      });
    });

    // Workflow process steps timeline interaction
    const wfButtons = document.querySelectorAll('.wf-step-btn');
    const wfNum = document.getElementById('wf-num');
    const wfTitle = document.getElementById('wf-title');
    const wfDesc = document.getElementById('wf-desc');
    const wfDuration = document.getElementById('wf-duration');
    const wfTools = document.getElementById('wf-tools');

    wfButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = btn.getAttribute('data-step');
        const title = btn.getAttribute('data-title');
        const duration = btn.getAttribute('data-duration');
        const desc = btn.getAttribute('data-desc');
        const tools = btn.getAttribute('data-tools');

        // Reset buttons
        wfButtons.forEach((b) => {
          b.classList.remove('bg-charcoal', 'text-white', 'border-charcoal', 'shadow-premium');
          b.classList.add('bg-white', 'text-charcoal', 'border-silver-dark/30');
        });

        // Set active
        btn.classList.remove('bg-white', 'text-charcoal', 'border-silver-dark/30');
        btn.classList.add('bg-charcoal', 'text-white', 'border-charcoal', 'shadow-premium');

        // Update Visualizer
        if (wfNum) wfNum.innerText = step;
        if (wfTitle) wfTitle.innerText = title;
        if (wfDesc) wfDesc.innerText = desc;
        if (wfDuration) wfDuration.innerText = duration;
        if (wfTools) wfTools.innerText = tools;
      });
    });

    // Smart Quote builder to WhatsApp format
    const form = document.getElementById('quote-builder-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const mat = document.getElementById('quote-material').value;
        const thick = document.getElementById('quote-thickness').value;
        const qty = document.getElementById('quote-qty').value;
        const service = document.getElementById('quote-service').value;
        const notes = document.getElementById('quote-notes').value;

        const baseMessage = `Halo Jasa Cutting Laser, saya ingin mengajukan permohonan penawaran quote resmi untuk pengerjaan project berikut:\n\n` +
          `• Jenis Layanan: ${service}\n` +
          `• Material Utama: ${mat}\n` +
          `• Ketebalan Bahan: ${thick}\n` +
          `• Estimasi Volume: ${qty} Pcs\n` +
          `• Rincian Ukuran / Catatan Tambahan: ${notes}\n\n` +
          `Mohon estimasi biaya pengerjaan dan total waktu produksinya. Terima kasih!`;

        const waURL = `https://api.whatsapp.com/send?phone=6285165693179&text=${encodeURIComponent(baseMessage)}`;
        window.open(waURL, '_blank');
      });
    }
  });
</script>
