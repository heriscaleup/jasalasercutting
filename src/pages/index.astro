---
// src/pages/index.astro
// Halaman utama yang diredesain ke standar visual "Awwwards" dengan fitur interaktif tingkat tinggi.

// Import komponen-komponen utama
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';

// Import data terpusat dari constants.js
import { SERVICES, MATERIALS, TESTIMONIALS, PORTFOLIO, FAQ, SITE_CONFIG } from '../utils/constants.js';

// Import fungsi-fungsi SEO dari seo.ts
import { generateMetaTags, generateFAQSchema, generateReviewSchema } from '../utils/seo.ts';

// 1. GENERATE META TAGS
const metaTags = generateMetaTags({
  title: "Jasa Laser Cutting & Layanan Laser Cutting Profesional - Akrilik, Kayu, Metal Banten",
  description: "Jasa laser cutting & layanan laser cutting presisi tinggi untuk akrilik, kayu, metal, MDF, ACP, PVC. Melayani Serang, Tangerang, Cilegon, Jakarta, Bekasi, Bogor, Depok & seluruh Jabodetabek-Banten. Konsultasi gratis!",
  keywords: "jasa laser cutting, layanan laser cutting, jasa cutting laser, laser cutting serang, laser cutting tangerang, laser cutting jakarta, laser cutting bekasi, laser cutting bogor, cnc router, laser fiber cutting, potong akrilik, potong kayu, cutting metal, jasa metal presisi",
  url: "/", // URL canonical untuk halaman ini
  type: "website",
  image: "/images/logo.webp", // Gambar utama untuk social media sharing
  publishedTime: "2025-01-01T00:00:00Z",
  modifiedTime: "2026-05-22T10:00:00Z",
  author: SITE_CONFIG.author
});

// 2. GENERATE STRUCTURED DATA (JSON-LD)
const faqSchema = generateFAQSchema(FAQ);
const reviewSchema = generateReviewSchema(TESTIMONIALS);
---

<BaseLayout
  metaTags={metaTags}
  jsonLd={[faqSchema, reviewSchema]}
>
  <Header slot="header" />

  <main class="space-y-0">
    <Hero />

    <!-- Bagian Layanan / Services -->
    <section id="services" class="section-padding bg-white relative overflow-hidden">
      <div class="container-custom relative z-10">
        <div class="text-center mb-20 max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center px-4 py-1.5 bg-laser-green/10 border border-laser-green/20 rounded-full text-laser-green font-bold text-xs tracking-wider uppercase">
            Teknologi Presisi Tinggi
          </div>
          <h2 class="heading-lg text-charcoal">
            Layanan Laser Cutting Profesional
          </h2>
          <p class="text-lg text-graphite/80 leading-relaxed font-sans">
            Solusi pemotongan terbaik menggunakan mesin mutakhir untuk hasil potongan super rapi dengan akurasi pengerjaan kelas satu.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {SERVICES.map((service, index) => (
            <div class="group bg-white rounded-3xl overflow-hidden hover-lift border border-silver-mid/50 flex flex-col">
              <div class="relative h-60 overflow-hidden">
                <img
                  src={service.image}
                  alt={`Layanan ${service.name} di Indonesia`}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                  loading="lazy"
                  width="400"
                  height="240"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-sm px-3.5 py-1.5 rounded-full text-xs font-bold text-laser-green shadow-sm">
                  Service 0{index + 1}
                </div>
              </div>
              
              <div class="p-8 flex flex-col flex-1 space-y-6 justify-between">
                <div class="space-y-3">
                  <h3 class="text-xl font-bold text-charcoal group-hover:text-laser-green transition-colors duration-200">
                    {service.name}
                  </h3>
                  <p class="text-sm text-graphite/90 leading-relaxed font-sans">
                    {service.description}
                  </p>
                </div>
                
                <div class="space-y-4 border-t border-silver-mid/50 pt-6">
                  <div class="flex justify-between text-xs text-graphite/60 font-semibold uppercase tracking-wider">
                    <span>Ketebalan</span>
                    <span class="text-charcoal font-bold">{service.thickness}</span>
                  </div>
                  <div class="flex justify-between text-xs text-graphite/60 font-semibold uppercase tracking-wider">
                    <span>Toleransi</span>
                    <span class="text-laser-green font-bold">{service.tolerance}</span>
                  </div>

                  <a
                    href={`/${service.slug}/`}
                    class="btn-accent w-full group/btn text-sm py-3.5"
                  >
                    <span>Pelajari Detail</span>
                    <svg class="w-4 h-4 text-charcoal group-hover/btn:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INTERACTIVE SECTION 1: TAB-BASED MATERIAL SHOWCASE -->
    <section id="materials" class="section-padding bg-[#FAFAFA] border-t border-b border-silver-mid/50 relative overflow-hidden">
      <div class="container-custom relative z-10">
        <div class="text-center mb-16 max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center px-4 py-1.5 bg-laser-green/10 border border-laser-green/20 rounded-full text-laser-green font-bold text-xs tracking-wider uppercase">
            Material Showcase
          </div>
          <h2 class="heading-lg text-charcoal">
            Eksplorasi Material Premium Kami
          </h2>
          <p class="text-lg text-graphite/80 font-sans">
            Klik material untuk memvisualisasikan spesifikasi teknis, ketebalan optimal, dan aplikasi utama secara dinamis.
          </p>
        </div>

        <!-- Interactive Tabs Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">

          <!-- Tab Selectors (Left side) -->
          <div class="lg:col-span-4 flex flex-row lg:flex-col overflow-x-auto lg:overflow-x-visible gap-3 p-1 scrollbar-none" id="material-tab-selectors">
            {MATERIALS.slice(0, 6).map((material, idx) => (
              <button
                class="material-tab-btn flex-1 flex items-center justify-between text-left px-6 py-5 rounded-2xl border transition-all duration-300 font-sans group/btn flex-shrink-0"
                data-material-id={material.id}
                class:list={[
                  idx === 0
                    ? 'bg-charcoal text-white border-charcoal shadow-premium'
                    : 'bg-white text-charcoal border-silver-dark/30 hover:border-laser-green'
                ]}
              >
                <div class="flex items-center space-x-4">
                  <span class="w-7 h-7 bg-laser-green/20 text-laser-green rounded-lg flex items-center justify-center text-xs font-bold group-hover/btn:bg-laser-green group-hover/btn:text-white transition-colors">
                    0{idx + 1}
                  </span>
                  <span class="font-bold text-base tracking-tight">{material.name}</span>
                </div>
                <svg class="w-4 h-4 hidden lg:block opacity-60 group-hover/btn:opacity-100 group-hover/btn:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            ))}
          </div>

          <!-- Active Material Visual Panel (Right side) -->
          <div class="lg:col-span-8 bg-white border border-silver-mid/50 rounded-3xl p-8 md:p-12 shadow-premium flex flex-col md:flex-row gap-8 relative overflow-hidden" id="material-panel-content">
            <!-- Content gets rendered and updated via client script dynamically -->
            <div class="flex-1 space-y-6">
              <h3 class="text-3xl font-heading font-bold text-charcoal" id="panel-title">{MATERIALS[0].name}</h3>
              <p class="text-base text-graphite/90 font-sans leading-relaxed" id="panel-desc">
                {MATERIALS[0].description}
              </p>
              
              <div class="grid grid-cols-2 gap-6 pt-4 border-t border-silver-mid/60">
                <div>
                  <span class="block text-xs font-bold text-graphite/50 uppercase tracking-widest mb-1">Ketebalan Optimal</span>
                  <span class="text-lg font-bold text-charcoal" id="panel-thickness">{MATERIALS[0].thickness}</span>
                </div>
                <div>
                  <span class="block text-xs font-bold text-graphite/50 uppercase tracking-widest mb-1">Keunggulan Utama</span>
                  <span class="text-lg font-bold text-laser-green" id="panel-advantage">{MATERIALS[0].advantages?.[0] || 'Kualitas Premium'}</span>
                </div>
              </div>

              <div class="space-y-2 pt-2">
                <span class="block text-xs font-bold text-graphite/50 uppercase tracking-widest">Aplikasi Penggunaan</span>
                <div class="flex flex-wrap gap-2" id="panel-apps">
                  {MATERIALS[0].applications.map((app) => (
                    <span class="px-3.5 py-1.5 bg-silver-mid text-charcoal font-semibold text-xs rounded-full">{app}</span>
                  ))}
                </div>
              </div>

              <div class="pt-6">
                <a href={`/${MATERIALS[0].slug}`} class="btn-primary inline-flex text-sm py-3.5" id="panel-link">
                  <span>Lihat Detail Material</span>
                </a>
              </div>
            </div>

            <!-- Material Image Frame with Depth effect -->
            <div class="flex-1 relative aspect-video md:aspect-square bg-silver-mid/30 rounded-2xl overflow-hidden shadow-inner border border-silver-mid/30">
              <img
                src={MATERIALS[0].image}
                alt={MATERIALS[0].name}
                class="w-full h-full object-cover"
                id="panel-image"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 via-transparent to-transparent"></div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- INTERACTIVE SECTION 2: PROCESS STEP-BY-STEP TIMELINE -->
    <section class="section-padding bg-white relative overflow-hidden">
      <div class="container-custom relative z-10">
        <div class="text-center mb-20 max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center px-4 py-1.5 bg-laser-green/10 border border-laser-green/20 rounded-full text-laser-green font-bold text-xs tracking-wider uppercase">
            Workflow Pengerjaan
          </div>
          <h2 class="heading-lg text-charcoal">
            Alur Kerja Presisi & Transparan
          </h2>
          <p class="text-lg text-graphite/80 font-sans">
            Kami memprioritaskan komunikasi transparan dari awal file design dikirim hingga produk terdistribusi sempurna ke tangan Anda.
          </p>
        </div>

        <!-- Interactive Stepper Timeline -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">

          <!-- Large Interactive Visualizer Panel (Left) -->
          <div class="lg:col-span-7 bg-[#FAFAFA] border border-silver-mid/50 rounded-3xl p-8 md:p-12 shadow-premium flex flex-col justify-between space-y-8" id="workflow-visualizer">
            <div class="space-y-4">
              <div class="flex items-center space-x-3">
                <span class="w-10 h-10 bg-laser-green text-white font-bold rounded-xl flex items-center justify-center font-heading" id="wf-num">1</span>
                <h3 class="text-2xl font-heading font-bold text-charcoal" id="wf-title">Konsultasi & Penawaran</h3>
              </div>
              <p class="text-base text-graphite/90 leading-relaxed font-sans" id="wf-desc">
                Diskusi intensif tentang kebutuhan project, material terbaik, estimasi pengerjaan, dan pengiriman penawaran harga (quote) resmi yang transparan tanpa biaya tersembunyi.
              </p>
            </div>

            <!-- Beautiful Mockup detailing tools used per step -->
            <div class="bg-white rounded-2xl p-6 border border-silver-mid/50 grid grid-cols-2 md:grid-cols-4 gap-6">
              <div class="space-y-1">
                <span class="block text-[10px] font-bold text-graphite/50 uppercase tracking-wider">Durasi</span>
                <span class="block text-sm font-bold text-charcoal" id="wf-duration">30 menit - 2 jam</span>
              </div>
              <div class="space-y-1 col-span-3">
                <span class="block text-[10px] font-bold text-graphite/50 uppercase tracking-wider">Metode & Alat Komunikasi</span>
                <span class="block text-sm font-bold text-laser-green" id="wf-tools">WhatsApp, Email, Telepon, Kunjungan Langsung</span>
              </div>
            </div>
          </div>

          <!-- Step Navigation Panel (Right) -->
          <div class="lg:col-span-5 flex flex-col gap-3">
            {[
              { step: 1, title: 'Konsultasi & Quote', duration: '30 menit - 2 jam', desc: 'Diskusi intensif tentang kebutuhan project, material terbaik, estimasi pengerjaan, dan pengiriman penawaran harga (quote) resmi yang transparan tanpa biaya tersembunyi.', tools: 'WhatsApp, Email, Telepon, Kunjungan Langsung' },
              { step: 2, title: 'Persiapan File & Optimasi', duration: '2 - 24 jam', desc: 'Melakukan peninjauan format file (DWG, AI, DXF), optimasi tata letak (nesting) untuk meminimalisir waste material, serta membuat simulasi sebelum mesin memproses.', tools: 'AutoCAD, CorelDraw, Illustrator, Lantek Nesting' },
              { step: 3, title: 'Pengadaan Material', duration: '1 - 3 hari', desc: 'Pengadaan bahan baku sesuai ukuran, ketebalan, dan standar kualitas industri yang disepakati bersama sebelum masuk ke fase pemotongan.', tools: 'Mitra Vendor Resmi, Quality Control Bahan' },
              { step: 4, title: 'Produksi & Quality Control', duration: '1 - 7 hari', desc: 'Proses pemotongan (cutting/engraving) dipantau real-time oleh teknisi ahli serta pengecekan visual menyeluruh untuk memastikan toleransi ketebalan ideal.', tools: 'Laser Fiber, Laser CO2, CNC Router, Galvo' },
              { step: 5, title: 'Pengemasan & Pengiriman', duration: '1 - 2 hari', desc: 'Pengemasan khusus menggunakan bubble wrap/kayu peti agar aman dari risiko benturan, dilanjutkan ekspedisi pengantaran langsung ke gudang tujuan.', tools: 'Peti Kayu, Bubble Wrap, Armada Pickup, Ekspedisi' }
            ].map((wf, idx) => (
              <button
                class="wf-step-btn flex items-center justify-between text-left p-5 rounded-2xl border transition-all duration-300 font-sans group/btn cursor-pointer"
                data-step={wf.step}
                data-title={wf.title}
                data-duration={wf.duration}
                data-desc={wf.desc}
                data-tools={wf.tools}
                class:list={[
                  idx === 0
                    ? 'bg-charcoal text-white border-charcoal shadow-premium'
                    : 'bg-white text-charcoal border-silver-dark/30 hover:border-laser-green'
                ]}
              >
                <div class="flex items-center space-x-4">
                  <span class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs bg-laser-green/20 text-laser-green font-heading group-hover/btn:bg-laser-green group-hover/btn:text-white transition-colors">
                    0{wf.step}
                  </span>
                  <span class="font-bold text-base tracking-tight">{wf.title}</span>
                </div>
                <div class="text-xs opacity-60 font-medium hidden sm:block">{wf.duration}</div>
              </button>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- Bagian Portfolio -->
    <section id="portfolio" class="section-padding bg-[#FAFAFA] border-t border-b border-silver-mid/50">
      <div class="container-custom">
        <div class="text-center mb-16 max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center px-4 py-1.5 bg-laser-green/10 border border-laser-green/20 rounded-full text-laser-green font-bold text-xs tracking-wider uppercase">
            Galeri Kerja
          </div>
          <h2 class="heading-lg text-charcoal">
            Portfolio Proyek Pilihan
          </h2>
          <p class="text-lg text-graphite/80 font-sans">
            Lihat hasil pengerjaan fabrikasi profesional kami untuk berbagai korporasi, UMKM, dan arsitek di Indonesia.
          </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {PORTFOLIO.map((project) => (
            <div class="group relative block overflow-hidden rounded-3xl bg-white border border-silver-mid/50 shadow-premium hover-lift">
              <div class="relative h-80 overflow-hidden">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                  width="400"
                  height="320"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/20 to-transparent opacity-80"></div>
                
                <div class="absolute top-4 left-4">
                  <span class="px-3.5 py-1.5 bg-laser-green text-white text-xs font-bold rounded-full uppercase tracking-wider shadow-sm">
                    {project.category}
                  </span>
                </div>
                
                <div class="absolute bottom-0 left-0 right-0 p-6 text-white space-y-2">
                  <h3 class="text-lg font-bold font-heading line-clamp-1">
                    {project.title}
                  </h3>
                  <div class="flex justify-between items-center text-xs text-silver-mid/90 font-sans">
                    <span>{project.material}</span>
                    <span class="font-bold text-laser-green">{project.service}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <div class="text-center mt-12">
          <a href="/portfolio/" class="btn-secondary inline-flex text-base py-4 px-10">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <span>Buka Semua Galeri Portfolio</span>
          </a>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE SECTION 3: INTERACTIVE WHATSAPP QUOTE BUILDER -->
    <section class="section-padding bg-white relative overflow-hidden" id="interactive-quote">
      <div class="container-custom relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

          <div class="lg:col-span-5 space-y-6">
            <div class="inline-flex items-center px-4 py-1.5 bg-laser-green/10 border border-laser-green/20 rounded-full text-laser-green font-bold text-xs tracking-wider uppercase">
              Estimator & Penawaran Instan
            </div>
            <h2 class="heading-lg text-charcoal leading-tight">
              Dapatkan Kalkulasi Penawaran Sekarang
            </h2>
            <p class="text-base md:text-lg text-graphite/90 leading-relaxed font-sans">
              Formulir pintar kami akan otomatis menyusun rincian spesifikasi project Anda, siap diteruskan ke tim marketing kami untuk diproses cepat.
            </p>
            <div class="p-5 bg-[#FAFAFA] rounded-2xl border border-silver-mid/50 space-y-4">
              <div class="flex items-center space-x-3 text-sm font-semibold text-charcoal">
                <div class="w-6 h-6 bg-laser-green/15 text-laser-green rounded-full flex items-center justify-center font-bold">✓</div>
                <span>Free Penyesuaian Nesting Layout</span>
              </div>
              <div class="flex items-center space-x-3 text-sm font-semibold text-charcoal">
                <div class="w-6 h-6 bg-laser-green/15 text-laser-green rounded-full flex items-center justify-center font-bold">✓</div>
                <span>Diskon Spesial Volume Industri / Bulk</span>
              </div>
              <div class="flex items-center space-x-3 text-sm font-semibold text-charcoal">
                <div class="w-6 h-6 bg-laser-green/15 text-laser-green rounded-full flex items-center justify-center font-bold">✓</div>
                <span>Garansi 100% Retur Jika Salah Potong</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <form class="bg-[#FAFAFA] border border-silver-mid/50 rounded-3xl p-8 md:p-10 shadow-premium space-y-6" id="quote-builder-form">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Select Material -->
                <div class="space-y-2">
                  <label for="quote-material" class="block text-sm font-bold text-charcoal uppercase tracking-wider">Pilih Material</label>
                  <select id="quote-material" class="w-full bg-white border border-silver-dark/40 rounded-xl px-4 py-3 text-sm focus:border-laser-green focus:ring-laser-green">
                    {MATERIALS.map((m) => (
                      <option value={m.name}>{m.name}</option>
                    ))}
                  </select>
                </div>

                <!-- Thickness Selection -->
                <div class="space-y-2">
                  <label for="quote-thickness" class="block text-sm font-bold text-charcoal uppercase tracking-wider">Ketebalan Bahan</label>
                  <input type="text" id="quote-thickness" placeholder="Contoh: 3mm, 5mm, 10mm" class="w-full bg-white border border-silver-dark/40 rounded-xl px-4 py-3 text-sm focus:border-laser-green focus:ring-laser-green" required />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Volume / Quantity -->
                <div class="space-y-2">
                  <label for="quote-qty" class="block text-sm font-bold text-charcoal uppercase tracking-wider">Volume / Jumlah (Pcs)</label>
                  <input type="number" id="quote-qty" min="1" placeholder="Contoh: 50" class="w-full bg-white border border-silver-dark/40 rounded-xl px-4 py-3 text-sm focus:border-laser-green focus:ring-laser-green" required />
                </div>

                <!-- Laser/CNC Service Type -->
                <div class="space-y-2">
                  <label for="quote-service" class="block text-sm font-bold text-charcoal uppercase tracking-wider">Jenis Pemrosesan</label>
                  <select id="quote-service" class="w-full bg-white border border-silver-dark/40 rounded-xl px-4 py-3 text-sm focus:border-laser-green focus:ring-laser-green">
                    {SERVICES.map((s) => (
                      <option value={s.name}>{s.name}</option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Message/Dimensions -->
              <div class="space-y-2">
                <label for="quote-notes" class="block text-sm font-bold text-charcoal uppercase tracking-wider">Detail Tambahan / Ukuran Dimensi</label>
                <textarea id="quote-notes" rows="3" placeholder="Tulis rincian ukuran (P x L dalam cm), catatan tambahan, atau jenis finishing..." class="w-full bg-white border border-silver-dark/40 rounded-xl px-4 py-3 text-sm focus:border-laser-green focus:ring-laser-green" required></textarea>
              </div>

              <!-- Submit to WhatsApp Button -->
              <button
                type="submit"
                class="btn-primary w-full py-4 text-base shadow-laser-glow flex items-center justify-center space-x-2"
              >
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
