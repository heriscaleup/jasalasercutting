---
// src/pages/index.astro
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import { MATERIALS, PORTFOLIO_PROJECTS, FAQ, TESTIMONIALS, SITE_CONFIG } from '../utils/constants.js';
import { generateMetaTags, generateFAQSchema, generateReviewSchema } from '../utils/seo.ts';

const metaTags = generateMetaTags({
  title: "Jasa Laser Cutting & Layanan Laser Cutting Profesional",
  description: "Jasa laser cutting & layanan laser cutting presisi tinggi. Melayani Banten & Jabodetabek.",
  keywords: "jasa laser cutting, layanan laser cutting",
  url: "/",
  type: "website",
  image: "/images/logo.webp",
  publishedTime: "2025-01-01T00:00:00Z",
  modifiedTime: "2026-05-22T10:00:00Z",
  author: SITE_CONFIG.author
});

const faqSchema = generateFAQSchema(FAQ);
const reviewSchema = generateReviewSchema(TESTIMONIALS);

const portfolioSubset = PORTFOLIO_PROJECTS.slice(0, 6);
---

<BaseLayout metaTags={metaTags} jsonLd={[faqSchema, reviewSchema]}>
  <Header slot="header" />

  <style>
    :root {
      --color-background: #0B0D0C;
      --color-surface: #121514;
      --line: #303531;
    }
    body {
      background-color: var(--color-background);
      color: #F3F0E8;
    }
    .bg-background { background-color: var(--color-background); }
    .bg-surface { background-color: var(--color-surface); }
    .border-\[var\(--line\)\] { border-color: var(--line); }
    .text-text-main { color: #F3F0E8; }
    .text-text-secondary { color: #A7ADA8; }
    .text-accent { color: #10B981; }
    .bg-paper { background-color: #E8E4D9; }
    .text-dark-ink { color: #111311; }

    .eyebrow {
      font-family: "IBM Plex Mono", monospace;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      font-size: 0.68rem;
    }

    @keyframes marquee-track {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .marquee-track {
      display: inline-flex;
      animation: marquee-track 30s linear infinite;
    }
  </style>

  <main class="space-y-0 bg-background text-text-main font-sans">
    
    <!-- A. HERO SECTION -->
    <section class="relative overflow-hidden min-h-[860px] border-b border-[var(--line)]">
      <div class="absolute inset-0 z-0">
        <Image 
          src="/images/home/hero-workshop.webp" 
          alt="Workshop Fabrication" 
          width={1920} 
          height={1080}
          widths={[320, 640, 1024, 1920]}
          sizes="(max-width: 1024px) 100vw, 1024px"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(7,9,8,0.98) 0%, rgba(7,9,8,0.8) 38%, rgba(7,9,8,0.18) 72%, rgba(7,9,8,0.38) 100%);"></div>
      </div>
      
      <div class="container-custom relative z-10 pt-40 pb-20 flex flex-col justify-between min-h-[860px]">
        <div class="max-w-4xl">
          <p class="eyebrow text-text-secondary mb-6">STUDIO FABRIKASI CUSTOM · TANGERANG & BANTEN</p>
          <h1 class="font-heading font-bold text-text-main text-[clamp(3.5rem,8.4vw,8.6rem)] leading-[0.84] tracking-[-0.065em] mb-8">
            Presisi laser cutting untuk ruang nyata.
          </h1>
          <p class="text-text-secondary text-xl max-w-2xl font-sans mb-12">
            Dari panel fasad and pagar hingga signage, partisi, serta display. Kami menerjemahkan referensi CAD menjadi material, modul, dan detail yang siap dipasang di lapangan.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href="https://api.whatsapp.com/send?phone=6285165693179" class="button-primary bg-accent text-background font-mono px-6 py-4 flex items-center gap-2 hover:bg-white transition-colors " aria-label="Mulai Konsultasi Proyek">
              Mulai Konsultasi Proyek
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-5-5 5 5-5 5"></path>
              </svg>
            </a>
            <a href="/portfolio/" class="px-6 py-4 border border-[var(--line)] text-text-main font-mono hover:bg-surface transition-colors " aria-label="Galeri Hasil Potong">
              Galeri Hasil Potong
            </a>
          </div>
        </div>

        <div class="mt-auto pt-16 border-t border-[var(--line)]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="border-r border-[var(--line)] pr-8">
              <p class="font-mono text-text-secondary text-sm mb-2">01 / KAPABILITAS</p>
              <p class="font-mono text-text-main">Fiber Laser · CO2 · CNC Router · Galvo</p>
            </div>
            <div class="border-r border-[var(--line)] pr-8">
              <p class="font-mono text-text-secondary text-sm mb-2">02 / CAKUPAN</p>
              <p class="font-mono text-text-main">Arsitektur, Interior, Hunian & Komersial</p>
            </div>
            <div>
              <p class="font-mono text-text-secondary text-sm mb-2">03 / TOLERANSI</p>
              <p class="font-mono text-text-main">Presisi tinggi hingga 0.1mm</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- B. THE MARQUEE BANNER -->
    <section class="bg-paper text-dark-ink overflow-hidden py-4 border-b border-[var(--line)]">
      <div class="whitespace-nowrap flex marquee-track font-mono text-sm tracking-widest font-bold">
        <span class="px-4">FABRIKASI PRESISI ✳ BAHAN METAL & NON-METAL ✳ GARANSI RETUR ✳ KAPASITAS BULK INDUSTRI ✳ MADE IN TANGERANG ✳ </span>
        <span class="px-4">FABRIKASI PRESISI ✳ BAHAN METAL & NON-METAL ✳ GARANSI RETUR ✳ KAPASITAS BULK INDUSTRI ✳ MADE IN TANGERANG ✳ </span>
        <span class="px-4">FABRIKASI PRESISI ✳ BAHAN METAL & NON-METAL ✳ GARANSI RETUR ✳ KAPASITAS BULK INDUSTRI ✳ MADE IN TANGERANG ✳ </span>
        <span class="px-4">FABRIKASI PRESISI ✳ BAHAN METAL & NON-METAL ✳ GARANSI RETUR ✳ KAPASITAS BULK INDUSTRI ✳ MADE IN TANGERANG ✳ </span>
      </div>
    </section>

    <!-- C. THE PRODUCT EXHIBIT -->
    <section id="products" class="py-24 border-b border-[var(--line)]">
      <div class="container-custom">
        <div class="mb-16">
          <p class="eyebrow text-text-secondary mb-4">01 / KATALOG PRODUK</p>
          <h2 class="font-heading font-bold text-text-main text-[clamp(2.35rem,4.8vw,5rem)] leading-[0.96] tracking-[-0.045em] mb-6">
            Spesialisasi Fabrikasi
          </h2>
          <p class="text-text-secondary text-lg max-w-2xl font-sans">
            Kami memproduksi komponen custom arsitektur, elemen dekoratif, dan kebutuhan signage komersial.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {MATERIALS.map((material) => (
            <div class="group bg-surface border border-[var(--line)] hover:border-accent/40 transition-all duration-300 hover:-translate-y-3 relative overflow-hidden flex flex-col aspect-square">
              <div class="absolute top-4 left-4 z-20">
                <span class="bg-background/80 backdrop-blur-md px-3 py-1 font-mono text-xs text-text-main border border-[var(--line)]">
                  {material.name}
                </span>
              </div>
              <div class="flex-1 relative bg-background/50">
                <Image 
                  src={material.image || '/images/placeholder.webp'} 
                  alt={material.name} 
                  width={600} 
                  height={600}
                  widths={[320, 600]}
                  sizes="(max-width: 600px) 100vw, 600px"
                  class="w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity"
                />
              </div>
              <div class="p-6 border-t border-[var(--line)] bg-surface z-10">
                <div class="grid grid-cols-1 gap-2 text-xs">
                  <div class="flex justify-between border-b border-[var(--line)] pb-2">
                    <span class="font-mono text-text-secondary">MATERIAL</span>
                    <span class="font-mono text-text-main text-right">{material.name}</span>
                  </div>
                  <div class="flex justify-between border-b border-[var(--line)] pb-2">
                    <span class="font-mono text-text-secondary">TOLERANSI</span>
                    <span class="font-mono text-text-main text-right">± 0.1mm</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-mono text-text-secondary">APLIKASI</span>
                    <span class="font-mono text-text-main text-right">{material.applications?.[0] || 'Custom Fabrication'}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- D. PORTFOLIO SHOWCASE -->
    <section class="py-24 border-b border-[var(--line)]">
      <div class="container-custom">
        <div class="mb-16">
          <p class="eyebrow text-text-secondary mb-4">02 / ARSIP PROYEK</p>
          <h2 class="font-heading font-bold text-text-main text-[clamp(2.35rem,4.8vw,5rem)] leading-[0.96] tracking-[-0.045em] mb-6">
            Galeri Fabrikasi
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {portfolioSubset.map((project) => (
            <div class="group bg-surface border border-[var(--line)] flex flex-col aspect-[4/3] relative">
              <Image 
                src={project.image || '/images/placeholder.webp'} 
                alt={project.title} 
                width={800} 
                height={600}
                widths={[320, 640, 800]}
                sizes="(max-width: 800px) 100vw, 800px"
                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
              />
              <div class="absolute inset-0 bg-background/80 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-6 border border-accent/40 backdrop-blur-sm">
                <h3 class="font-heading text-2xl font-bold text-text-main mb-2">{project.title}</h3>
                <p class="font-mono text-xs text-text-secondary mb-4">{project.client}</p>
                <button 
                  class="view-detail-btn font-mono text-sm border border-[var(--line)] bg-background text-text-main py-2 px-4 hover:bg-accent hover:text-background transition-colors w-fit " aria-label="View Detail"
                  data-project-id={project.id}
                >
                  [ VIEW DETAIL ]
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <!-- MODAL ELEMENT -->
  <div id="portfolio-modal" class="fixed inset-0 hidden z-50 bg-background/95 backdrop-blur-md overflow-y-auto flex items-center justify-center p-4">
    <div class="bg-surface border border-[var(--line)] w-full max-w-4xl flex flex-col md:flex-row relative">
      <button id="close-modal" class="absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center bg-background border border-[var(--line)] text-text-secondary hover:text-text-main transition-colors " aria-label="Close Modal">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      
      <div class="w-full md:w-1/2 aspect-square md:aspect-auto border-b md:border-b-0 md:border-r border-[var(--line)] relative bg-background">
        <img id="modal-main-image" src="" alt="Project Image" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      
      <div class="w-full md:w-1/2 p-8 flex flex-col justify-center">
        <p class="eyebrow text-accent mb-4" id="modal-client">KLIENT</p>
        <h2 id="modal-title" class="font-heading font-bold text-text-main text-3xl mb-8 leading-tight">NAMA PROYEK</h2>
        
        <div class="space-y-6">
          <div>
            <p class="font-mono text-xs text-text-secondary mb-1">MATERIAL & TEKNIK</p>
            <p id="modal-material" class="font-sans text-text-main">MATERIAL</p>
          </div>
          <div>
            <p class="font-mono text-xs text-text-secondary mb-1">DESKRIPSI PROSES</p>
            <p id="modal-description" class="font-sans text-text-main text-sm leading-relaxed">DESKRIPSI</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ PORTFOLIO_PROJECTS }}>
  document.addEventListener('DOMContentLoaded', () => {
    const detailBtns = document.querySelectorAll('.view-detail-btn');
    const modal = document.getElementById('portfolio-modal');
    const closeBtn = document.getElementById('close-modal');
    
    const modalImg = document.getElementById('modal-main-image');
    const modalTitle = document.getElementById('modal-title');
    const modalClient = document.getElementById('modal-client');
    const modalMaterial = document.getElementById('modal-material');
    const modalDesc = document.getElementById('modal-description');

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };

    detailBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt(btn.getAttribute('data-project-id'));
        const project = PORTFOLIO_PROJECTS.find(p => p.id === id);
        
        if (project) {
          modalImg.src = project.image || '/images/placeholder.webp';
          modalImg.alt = project.title;
          modalTitle.textContent = project.title;
          modalClient.textContent = project.client;
          modalMaterial.textContent = project.material + ' / ' + project.technique;
          modalDesc.textContent = project.description;
          
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden'; // Prevent scrolling
        }
      });
    });

    closeBtn.addEventListener('click', closeModal);
    
    // Close on background click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>
