---
import { Image } from 'astro:assets';
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { SERVICES, SITE_CONFIG, FAQ } from '../utils/constants.js';
import { generateMetaTags, generateLocalBusinessSchema, generateBreadcrumbSchema, generateFAQSchema } from '../utils/seo.ts';

const city = 'Cilegon';
const cityLower = 'cilegon';

const metaTags = generateMetaTags({
  title: `Jasa Laser Cutting ${city} - Solusi Industri & Manufaktur Banten`,
  description: `Jasa laser cutting ${city} untuk kebutuhan industri, manufaktur, dan komersial. Cutting metal, acrylic, MDF, ACP di ${city} dengan presisi tinggi dan waktu cepat. Konsultasi gratis!`,
  keywords: `jasa laser cutting ${cityLower}, laser cutting ${cityLower}, cnc router ${cityLower}, cutting metal ${cityLower}, laser fiber ${cityLower}, laser co2 ${cityLower}, laser engraving ${cityLower}, jasa cutting industri ${cityLower}`,
  url: `/laser-cutting-${cityLower}/`,
  type: "website",
  image: "/images/metal.webp"
});

const localBusinessSchema = generateLocalBusinessSchema(city);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: `Laser Cutting ${city}`, url: `/laser-cutting-${cityLower}/` }
]);
const faqSchema = generateFAQSchema(FAQ.slice(0, 5));

const waMessage = encodeURIComponent(`Halo Jasalasercutting.com, saya butuh jasa laser cutting di ${city}. Bisa konsultasi?`);
---

<BaseLayout
  metaTags={metaTags}
  jsonLd={[localBusinessSchema, breadcrumbSchema, faqSchema]}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="text-white py-24 mt-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <div class="inline-flex items-center px-4 py-2 bg-laser-green/20 border border-laser-green/30 rounded-xl text-accent text-sm font-semibold mb-6">
        Melayani Area {city} & Sekitarnya
      </div>
      <h1 class="text-text-main md:text-5xl font-bold mb-6 leading-tight font-heading">
        Jasa Laser Cutting <span class="text-accent">{city}</span>
      </h1>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto mb-8">
        Solusi laser cutting industri di {city} — spesialis cutting metal, stainless steel, dan material industri berat. Cocok untuk kebutuhan manufaktur dan fabrikasi.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${waMessage}`}
          class="inline-flex items-center justify-center bg-laser-green hover:bg-green-600 text-white font-bold px-8 py-4 rounded-xl transition-all duration-300  hover:"
          target="_blank" rel="noopener noreferrer"
        >
          Konsultasi Gratis via WhatsApp
        </a>
        <a href="/portfolio/" class="inline-flex items-center justify-center bg-surface/10 hover:bg-surface border border-[var(--line)]/20 text-white font-semibold px-8 py-4 rounded-xl border border-white/20 transition-all duration-300">
          Lihat Portfolio
        </a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-surface border border-[var(--line)] py-3 border-b" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4">
      <ol class="flex items-center space-x-2 text-sm">
        <li><a href="/" class="text-text-secondary hover:text-accent">Beranda</a></li>
        <li class="text-text-secondary">/</li>
        <li class="text-text-secondary font-medium">Laser Cutting {city}</li>
      </ol>
    </div>
  </nav>

  <!-- Wilayah Layanan -->
  <section class="py-10 bg-laser-green/5 border-b border-laser-green/10">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">Jangkauan Layanan</p>
      <h2 class="text-text-main font-bold  mb-5 font-heading">Kecamatan & Kawasan yang Kami Layani di Cilegon</h2>
      <div class="flex flex-wrap justify-center gap-2">
        {['Ciwandan', 'Grogol', 'Purwakarta', 'Citangkil', 'Pulomerak', 'Jombang', 'Cibeber', 'Gerem', 'Kawasan Industri Krakatau'].map(area => (
          <span class="px-4 py-1.5 bg-surface border border-[var(--line)] rounded-xl text-sm text-text-secondary ">{area}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Layanan -->
  <section class="py-20 bg-surface border border-[var(--line)]">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-text-main md:text-4xl font-bold  mb-4 font-heading">Layanan Laser Cutting di {city}</h2>
        <p class="text-xl text-text-secondary max-w-3xl mx-auto">
          Dari laser fiber untuk metal hingga CNC router untuk kayu — semua tersedia di {city}.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {SERVICES.map(service => (
          <a href={`/${service.slug}/`} class="group bg-surface rounded-xl p-6 border border-[var(--line)] hover:border-laser-green hover: transition-all duration-300">
            <img src={service.image} alt={`${service.name} di ${city}`} class="w-full h-40 object-cover rounded-xl mb-4 group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <h3 class="text-text-main font-bold  mb-2 group-hover:text-accent transition-colors font-heading">{service.name}</h3>
            <p class="text-sm text-text-secondary">{service.description.substring(0, 80)}...</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Keunggulan -->
  <section class="py-20 bg-surface border border-[var(--line)]">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-text-main font-bold text-center  mb-12 font-heading">Kenapa Pilih Kami di {city}?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-surface border border-[var(--line)] rounded-xl p-8  text-center">
          <div class="w-16 h-16 bg-laser-green/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
          </div>
          <h3 class="text-text-main font-bold mb-3 font-heading">Spesialis Metal Industri</h3>
          <p class="text-text-secondary">Berpengalaman cutting metal tebal untuk kebutuhan industri di {city}</p>
        </div>
        <div class="bg-surface border border-[var(--line)] rounded-xl p-8  text-center">
          <div class="w-16 h-16 bg-laser-green/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-text-main font-bold mb-3 font-heading">Presisi Industri</h3>
          <p class="text-text-secondary">Toleransi ±0.05mm untuk komponen industri yang membutuhkan akurasi tinggi</p>
        </div>
        <div class="bg-surface border border-[var(--line)] rounded-xl p-8  text-center">
          <div class="w-16 h-16 bg-laser-green/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-text-main font-bold mb-3 font-heading">On-Time Delivery</h3>
          <p class="text-text-secondary">Pengiriman tepat waktu sesuai jadwal produksi klien di {city}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface border border-[var(--line)]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-text-main font-bold text-center  mb-12 font-heading">FAQ Laser Cutting {city}</h2>
      <div class="space-y-4">
        {FAQ.slice(0, 5).map((item) => (
          <div class="bg-surface rounded-xl border border-[var(--line)] overflow-hidden">
            <button
              class="w-full text-left px-6 py-5 font-semibold text-text-main hover:text-accent transition-colors flex justify-between items-center"
              onclick={`this.nextElementSibling.classList.toggle('hidden')`}
            >
              {item.question}
              <svg class="w-5 h-5 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="hidden px-6 pb-5 text-text-secondary leading-relaxed">{item.answer}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title={`Butuh Jasa Laser Cutting di ${city}?`}
    description={`Konsultasi gratis dengan tim ahli kami. Estimasi harga laser cutting di ${city} dalam 24 jam.`}
    primaryText="WhatsApp Sekarang"
    primaryLink={`https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${waMessage}`}
    secondaryText="Hubungi via Telepon"
    secondaryLink={`tel:${SITE_CONFIG.phone}`}
  />

  <Footer slot="footer" />
</BaseLayout>
