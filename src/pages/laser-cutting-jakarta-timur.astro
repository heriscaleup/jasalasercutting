---
import { Image } from 'astro:assets';
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { SERVICES, SITE_CONFIG, WHATSAPP_MESSAGES, FAQ } from '../utils/constants.js';
import { generateMetaTags, generateLocalBusinessSchema, generateBreadcrumbSchema, generateFAQSchema } from '../utils/seo.ts';

const city = 'Jakarta Timur';
const cityLower = 'jakarta-timur';

const metaTags = generateMetaTags({
  title: `Jasa Laser Cutting ${city} - CNC Router & Engraving Terpercaya`,
  description: `Jasa laser cutting ${city} profesional. Melayani cutting acrylic, kayu, metal, MDF, ACP, PVC di ${city} dan sekitarnya. Presisi tinggi, harga terjangkau, pengerjaan cepat. Hubungi kami sekarang!`,
  keywords: `jasa laser cutting ${cityLower}, laser cutting ${cityLower}, cnc router ${cityLower}, laser fiber ${cityLower}, laser co2 ${cityLower}, jasa cutting acrylic ${cityLower}, cutting metal ${cityLower}, laser engraving ${cityLower}, jasa laser jakarta timur`,
  url: `/laser-cutting-${cityLower}/`,
  type: "website",
  image: "/images/laserfiber.webp"
});

const localBusinessSchema = generateLocalBusinessSchema(city);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: `Laser Cutting ${city}`, url: `/laser-cutting-${cityLower}/` }
]);
const faqSchema = generateFAQSchema(FAQ.slice(0, 5));

const waMessage = encodeURIComponent(`Halo Jasalasercutting.com, saya butuh jasa laser cutting di ${city}. Bisa konsultasi?`);
---

<BaseLayout
  metaTags={metaTags}
  jsonLd={[localBusinessSchema, breadcrumbSchema, faqSchema]}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-charcoal to-gray-800 text-white py-24 mt-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <div class="inline-flex items-center px-4 py-2 bg-laser-green/20 border border-laser-green/30 rounded-xl text-accent text-sm font-semibold mb-6">
        Melayani Area {city} & Sekitarnya
      </div>
      <h1 class="text-text-main md:text-5xl font-bold mb-6 leading-tight font-heading">
        Jasa Laser Cutting <span class="text-accent">{city}</span>
      </h1>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto mb-8">
        Melayani kawasan industri terbesar Jakarta — dari Pulogadung hingga Cakung, kami siap menjadi mitra laser cutting acrylic, metal, MDF, ACP, dan PVC untuk kebutuhan manufaktur dan industri Anda.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${waMessage}`}
          class="inline-flex items-center justify-center bg-laser-green hover:bg-green-600 text-white font-bold px-8 py-4 rounded-xl transition-all duration-300  hover:"
          target="_blank" rel="noopener noreferrer"
        >
          Konsultasi Gratis via WhatsApp
        </a>
        <a href="/portfolio/" class="inline-flex items-center justify-center bg-surface/10 hover:bg-surface border border-[var(--line)]/20 text-white font-semibold px-8 py-4 rounded-xl border border-white/20 transition-all duration-300">
          Lihat Portfolio
        </a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-surface border border-[var(--line)] py-3 border-b" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4">
      <ol class="flex items-center space-x-2 text-sm">
        <li><a href="/" class="text-text-secondary hover:text-accent">Beranda</a></li>
        <li class="text-text-secondary">/</li>
        <li class="text-text-secondary font-medium">Laser Cutting {city}</li>
      </ol>
    </div>
  </nav>

  <!-- Wilayah Layanan -->
  <section class="py-10 bg-laser-green/5 border-b border-laser-green/10">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">Jangkauan Layanan</p>
      <h2 class="text-text-main font-bold  mb-5 font-heading">Kecamatan & Kawasan yang Kami Layani di Jakarta Timur</h2>
      <div class="flex flex-wrap justify-center gap-2">
        {['Pulogadung', 'Cakung', 'Duren Sawit', 'Jatinegara', 'Matraman', 'Kramat Jati', 'Pasar Rebo', 'Cipayung', 'Ciracas', 'Makasar'].map(area => (
          <span class="px-4 py-1.5 bg-surface border border-[var(--line)] rounded-xl text-sm text-text-secondary shadow-sm">{area}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Layanan di Kota Ini -->
  <section class="py-20 bg-surface border border-[var(--line)]">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-text-main md:text-4xl font-bold  mb-4 font-heading">Layanan Laser Cutting di {city}</h2>
        <p class="text-xl text-text-secondary max-w-3xl mx-auto">
          Kami melayani berbagai kebutuhan laser cutting di {city} dengan teknologi terdepan dan tim berpengalaman.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {SERVICES.map(service => (
          <a href={`/${service.slug}/`} class="group bg-surface rounded-xl p-6 border border-[var(--line)] hover:border-laser-green hover: transition-all duration-300">
            <img src={service.image} alt={`${service.name} di ${city}`} class="w-full h-40 object-cover rounded-xl mb-4 group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <h3 class="text-text-main font-bold  mb-2 group-hover:text-accent transition-colors font-heading">{service.name}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{service.description.substring(0, 80)}...</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Kenapa Pilih Kami -->
  <section class="py-20 bg-surface border border-[var(--line)]">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-text-main font-bold text-center  mb-12 font-heading">Kenapa Pilih Jasa Kami di {city}?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-surface border border-[var(--line)] rounded-xl p-8 shadow-sm text-center">
          <div class="w-16 h-16 bg-laser-green/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-text-main font-bold mb-3 font-heading">Pengerjaan Cepat</h3>
          <p class="text-text-secondary">Selesai dalam 1–3 hari kerja untuk order standar di area {city}</p>
        </div>
        <div class="bg-surface border border-[var(--line)] rounded-xl p-8 shadow-sm text-center">
          <div class="w-16 h-16 bg-laser-green/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-text-main font-bold mb-3 font-heading">Garansi Kualitas</h3>
          <p class="text-text-secondary">Hasil tidak sesuai spesifikasi? Kami ulang tanpa biaya tambahan</p>
        </div>
        <div class="bg-surface border border-[var(--line)] rounded-xl p-8 shadow-sm text-center">
          <div class="w-16 h-16 bg-laser-green/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            </svg>
          </div>
          <h3 class="text-text-main font-bold mb-3 font-heading">Pickup & Delivery {city}</h3>
          <p class="text-text-secondary">Layanan antar-jemput material di seluruh area {city} dan sekitarnya</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Material -->
  <section class="py-20 bg-surface border border-[var(--line)]">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-text-main font-bold text-center  mb-4 font-heading">Material yang Kami Kerjakan di {city}</h2>
      <p class="text-center text-text-secondary mb-12">Dari acrylic hingga metal — kami siap memproses berbagai material untuk kebutuhan Anda</p>
      <div class="flex flex-wrap justify-center gap-4">
        {['Acrylic', 'Stainless Steel', 'MDF', 'Plywood', 'PVC', 'ACP', 'GRC', 'Kayu', 'Kain', 'Kulit'].map(mat => (
          <span class="px-5 py-2 bg-surface border border-[var(--line)] hover:bg-laser-green hover:text-white rounded-xl text-sm font-medium text-text-secondary transition-colors duration-200 cursor-default">
            {mat}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface border border-[var(--line)]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-text-main font-bold text-center  mb-12 font-heading">FAQ Laser Cutting {city}</h2>
      <div class="space-y-4">
        {FAQ.slice(0, 5).map((item, i) => (
          <div class="bg-surface rounded-xl shadow-sm border border-[var(--line)] overflow-hidden">
            <button
              class="w-full text-left px-6 py-5 font-semibold text-text-main hover:text-accent transition-colors flex justify-between items-center"
              onclick={`this.nextElementSibling.classList.toggle('hidden')`}
            >
              {item.question}
              <svg class="w-5 h-5 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden px-6 pb-5 text-text-secondary leading-relaxed">{item.answer}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title={`Butuh Jasa Laser Cutting di ${city}?`}
    description={`Konsultasi gratis dengan tim ahli kami. Dapatkan estimasi harga laser cutting di ${city} dalam 24 jam.`}
    primaryText="WhatsApp Sekarang"
    primaryLink={`https://api.whatsapp.com/send?phone=${SITE_CONFIG.whatsapp}&text=${waMessage}`}
    secondaryText="Hubungi via Telepon"
    secondaryLink={`tel:${SITE_CONFIG.phone}`}
  />

  <Footer slot="footer" />
</BaseLayout>
